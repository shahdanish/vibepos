<Window x:Class="POSApp.UI.Views.SalesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSApp.UI.Views"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Sales Reports}" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="20">
            <Grid>
                <TextBlock Text="Sales Reports &amp; Analytics" FontSize="20" FontWeight="SemiBold" 
                           Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="Close" Click="Exit_Click" HorizontalAlignment="Right" 
                        Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>

        <!-- Quick Report Buttons -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="10,10,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Quick Reports" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                <WrapPanel Grid.Row="1">
                    <Button Content="Today" Command="{Binding ShowTodayCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="This week" Command="{Binding ShowThisWeekCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="This month" Command="{Binding ShowThisMonthCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="This year" Command="{Binding ShowThisYearCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="Custom range" Command="{Binding ShowCustomRangeCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="Invoice search" Command="{Binding ShowInvoiceSearchCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                </WrapPanel>

                <!-- Pharmacy Filters — visible only for pharmacy users -->
                <Border Grid.Row="2" Visibility="{Binding PharmacyFilterVisibility}"
                        Background="{DynamicResource SuccessSubtleBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Pharmacy:" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PharmacyOptions}"
                                  SelectedItem="{Binding PharmacyFilter}"
                                  FontSize="12" Padding="6,4"
                                  ToolTip="Filter by pharmacy"/>

                        <TextBlock Grid.Column="2" Text="Doctor:" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding DoctorOptions}"
                                  SelectedItem="{Binding DoctorFilter}"
                                  FontSize="12" Padding="6,4"
                                  ToolTip="Filter by doctor"/>

                        <TextBlock Grid.Column="4" Text="Product:" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox Grid.Column="5"
                                  ItemsSource="{Binding ProductOptions}"
                                  SelectedItem="{Binding ProductFilter}"
                                  FontSize="12" Padding="6,4"
                                  ToolTip="Filter by product (matches any item in the sale)"/>

                        <Button Grid.Column="6" Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource NeutralButton}"
                                Padding="10,5" Margin="12,0,0,0" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Sales Data Grid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ReportTitle}" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <!-- Search Panel (Collapsed by default) -->
                    <StackPanel Grid.Row="1" x:Name="SearchPanel" Visibility="{Binding SearchPanelVisibility}" Margin="0,0,0,15">
                        <!-- Invoice Search -->
                        <Border x:Name="InvoiceSearchPanel" Visibility="{Binding InvoiceSearchVisibility}" 
                                Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Invoice Number:" FontSize="14" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="14" Padding="8" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Search" Command="{Binding SearchInvoiceCommand}" 
                                        Style="{StaticResource SuccessButton}" MinWidth="100"/>
                            </Grid>
                        </Border>

                        <!-- Custom Date Range -->
                        <Border x:Name="CustomRangePanel" Visibility="{Binding CustomRangeVisibility}" 
                                Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="From:" FontSize="14" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding StartDate}" 
                                            FontSize="14" Padding="8" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="2" Text="To:" FontSize="14" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}" 
                                            FontSize="14" Padding="8" Margin="0,0,15,0"/>
                                <Button Grid.Column="4" Content="Show Report" Command="{Binding SearchDateRangeCommand}" 
                                        Style="{StaticResource InfoButton}" MinWidth="130"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" HeadersVisibility="All"
                              GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="120"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, Converter={StaticResource DateConverter}}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SaleType}" Width="90"/>
                            <DataGridTextColumn x:Name="CustomerColumn" Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn x:Name="DoctorColumn" Header="Doctor" Binding="{Binding Doctor.Name}" Width="110" MinWidth="80"
                                                Visibility="Collapsed"/>
                            <DataGridTextColumn Header="Items" Binding="{Binding SaleItems.Count}" Width="55" ElementStyle="{StaticResource CenterAlignStyle}"/>
                            <DataGridTextColumn Header="Discount" Binding="{Binding DiscountOnBill, StringFormat=N2}" Width="85" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="{x:Static helpers:Region.TotalLabel}" Binding="{Binding TotalBill, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{StaticResource InfoButton}"
                                                Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel: Summary & Details -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <!-- Summary Statistics -->
                        <TextBlock Text="Summary" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                        <Border Style="{StaticResource StatTile}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Total Sales" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalSales}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatTile}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Total Revenue" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource MoneyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatTile}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Total Cost" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalCost, Converter={StaticResource MoneyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatTile}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Total Profit" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalProfit, Converter={StaticResource MoneyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PurpleTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatTile}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Total Discount Given" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalDiscount, Converter={StaticResource MoneyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected Sale Details -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,10,0,0" 
                                Visibility="{Binding SelectedSaleVisibility}">
                            <StackPanel>
                                <TextBlock Text="Selected Sale Details" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Invoice:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedSale.InvoiceNumber}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Customer:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedSale.CustomerName}" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Payment:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedSale.PaymentType}" FontSize="14" HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Background="{DynamicResource PageBackgroundBrush}" Padding="10" Margin="0,10,0,0" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="Sale Items:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding SelectedSale.SaleItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition/>
                                                                <RowDefinition/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="{Binding ProductName}" FontSize="11" FontWeight="SemiBold"/>
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Quantity}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Text="{x:Static helpers:Region.TimesSymbol}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Text="{Binding UnitPrice, StringFormat=N2}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Text="{x:Static helpers:Region.EqualsSymbol}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,0"/>
                                                                <TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Button Content="Print Invoice" Command="{Binding PrintCommand}" 
                                        Style="{StaticResource SuccessButton}" Padding="12,8" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Print Report" Command="{Binding PrintReportCommand}" 
                        Style="{StaticResource InfoButton}" Margin="0,0,10,0" MinWidth="150"
                        FontSize="14"/>
                <Button Content="Export to Excel" Command="{Binding ExportCommand}" 
                        Style="{StaticResource SuccessButton}" Margin="0,0,10,0" MinWidth="150"
                        FontSize="14"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                        Style="{StaticResource SecondaryButton}" MinWidth="120"
                        FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
