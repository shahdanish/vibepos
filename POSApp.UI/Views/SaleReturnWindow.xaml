<Window x:Class="POSApp.UI.Views.SaleReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSApp.UI.Views"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Sale Return}" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: return screens keep a distinct colour so the mode is obvious -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Background="{DynamicResource DangerBrush}" Padding="12,8">
            <Grid>
                <TextBlock Text="Sale Return" Style="{StaticResource HeaderTitle}" HorizontalAlignment="Left"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#26FFFFFF" CornerRadius="14" Padding="12,4">
                    <TextBlock Text="{Binding ReturnInvoiceNumber, StringFormat='Return  #{0}'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Section -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Search Original Invoice" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Invoice #:" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8" Margin="0,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}"
                                Style="{StaticResource InfoButton}" MinWidth="110"/>

                        <TextBlock Grid.Column="3" Text="Return Date:" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="15,0,10,0"/>
                        <DatePicker Grid.Column="4" SelectedDate="{Binding ReturnDate}"
                                    FontSize="13" Padding="8" Width="130"/>
                    </Grid>

                    <!-- Inline status — no popup, just shows here -->
                    <TextBlock Grid.Row="2" Text="{Binding SearchStatus}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource InfoBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Return Items Section -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Items to Return" Style="{StaticResource SectionTitle}"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReturnItems}" AutoGenerateColumns="False"
                              CanUserAddRows="False" AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              HeadersVisibility="All" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Orig Qty" Binding="{Binding OriginalQuantity}" Width="80"
                                                ElementStyle="{StaticResource CenterAlignStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ret Qty" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80" ElementStyle="{StaticResource CenterAlignStyle}"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="95"
                                                ElementStyle="{StaticResource RightAlignStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, StringFormat=N0}" Width="70"
                                                ElementStyle="{StaticResource CenterAlignStyle}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="110"
                                                ElementStyle="{StaticResource RightAlignStyle}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Return Reason (Optional)" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="8" TextWrapping="Wrap" MaxLength="200"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource DangerSubtleBrush}" Padding="15" Margin="15,0,0,0"
                                CornerRadius="8" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.12" Direction="270" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="TOTAL REFUND" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalReturnAmount, Converter={StaticResource MoneyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="PROCESS &amp; PRINT" Command="{Binding ProcessAndPrintCommand}"
                            Style="{StaticResource SuccessButton}" Margin="0,0,10,5" MinWidth="170"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Style="{StaticResource WarningButton}" Margin="0,0,10,5" MinWidth="120"/>
                    <Button Content="Close" Click="Close_Click"
                            Style="{StaticResource NeutralButton}" Margin="0,0,0,5" MinWidth="110"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
