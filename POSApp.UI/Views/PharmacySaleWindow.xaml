<Window x:Class="POSApp.UI.Views.PharmacySaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Pharmacy Sale}"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="12,8">
            <Grid>
                <TextBlock Text="Pharmacy Sale" Style="{StaticResource HeaderTitle}" HorizontalAlignment="Left"/>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource WarningTextBrush}" CornerRadius="5" Padding="12,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSampleSale}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="★  SAMPLE PRODUCT  ★" FontSize="13" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#26FFFFFF" CornerRadius="14" Padding="12,4">
                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='Invoice  #{0}'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Single compact top card: all header fields + scan in 2 rows -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,8">
                <StackPanel>

                    <!-- Row 1: Pharmacy | Doctor | Payment | Date -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="135"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pharmacy -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="Pharmacy " Foreground="{DynamicResource DangerBrush}"/>
                                <Run Text="*" Foreground="{DynamicResource DangerBrush}"/>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="PharmacyCombo"
                                          ItemsSource="{Binding FilteredPharmacies}"
                                          SelectedItem="{Binding SelectedPharmacy}"
                                          DisplayMemberPath="DisplayLabel"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          Text="{Binding PharmacySearchText, UpdateSourceTrigger=PropertyChanged}"
                                          StaysOpenOnEdit="True" />
                                <Button Grid.Column="1" Content="＋" ToolTip="Add new pharmacy"
                                        Command="{Binding AddPharmacyCommand}"
                                        Width="26" Height="26" FontSize="15"
                                        Background="{DynamicResource SuccessBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Doctor -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Doctor (optional)" Style="{StaticResource FormLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="DoctorCombo"
                                          ItemsSource="{Binding FilteredDoctors}"
                                          SelectedItem="{Binding SelectedDoctor}"
                                          DisplayMemberPath="DisplayLabel"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          Text="{Binding DoctorSearchText, UpdateSourceTrigger=PropertyChanged}"
                                          StaysOpenOnEdit="True" />
                                <Button Grid.Column="1" Content="＋" ToolTip="Add new doctor"
                                        Command="{Binding AddDoctorCommand}"
                                        Width="26" Height="26" FontSize="15"
                                        Background="{DynamicResource SuccessBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Payment -->
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Payment" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding PaymentTypes}"
                                      SelectedItem="{Binding PaymentType}" />
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Sale Date" Style="{StaticResource FormLabel}"/>
                            <DatePicker SelectedDate="{Binding SaleDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Bill Note | Barcode | Product | AutoAdd | AutoPrint | Sample -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Bill Note (Optional)" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding BillNote, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Scan Barcode" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="BarcodeBox"
                                     Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" >
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Select Product" Style="{StaticResource FormLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding FilteredProducts}"
                                          SelectedItem="{Binding SelectedProduct}"
                                          DisplayMemberPath="ProductName"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                          StaysOpenOnEdit="True" />
                                <Button Grid.Column="1" Content="＋" ToolTip="Add new product"
                                        Command="{Binding AddProductCommand}"
                                        Width="26" Height="26" FontSize="15"
                                        Background="{DynamicResource SuccessBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Bottom">
                            <CheckBox Content="Auto Add" IsChecked="{Binding AutoAddItem}"
                                      FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Bottom">
                            <CheckBox Content="Auto Print" IsChecked="{Binding AutoPrint}"
                                      FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Sample Sale toggle -->
                        <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                            <TextBlock Text="Sample Sale" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,2" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSampleSale}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ToggleButton IsChecked="{Binding IsSampleSale}"
                                          Width="60" Height="22" Cursor="Hand"
                                          ToolTip="Mark this as a Sample Product Sale — receipt will be tagged">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Content" Value="OFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="11" Padding="6,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningTextBrush}"/>
                                                <Setter Property="Content" Value="ON"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Items Grid -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Sale Items" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" ItemsSource="{Binding SaleItems}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              HeadersVisibility="All" GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Unit Price" Width="95" ElementStyle="{StaticResource RightAlignStyle}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UnitPrice" StringFormat="N2" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Qty" Width="65" ElementStyle="{StaticResource CenterAlignStyle}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Quantity" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bonus" Width="65" ElementStyle="{StaticResource CenterAlignStyle}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Bonus" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Disc %" Width="65" ElementStyle="{StaticResource CenterAlignStyle}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="DiscountPercent" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Batch No" Binding="{Binding BatchNo}"
                                                IsReadOnly="True" Width="85" ElementStyle="{StaticResource CenterAlignStyle}"/>
                            <DataGridTextColumn Header="Expiry" Width="65" IsReadOnly="True"
                                                Binding="{Binding ExpiryDate, Converter={StaticResource DateConverter}, ConverterParameter=monthyear}"
                                                ElementStyle="{StaticResource CenterAlignStyle}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}"
                                                IsReadOnly="True" Width="100" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTemplateColumn Header="Del" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerTextBrush}"
                                                FontSize="12" ToolTip="Remove item"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Pick a medicine above to add items"
                               Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding HasItems, ElementName=ItemsGrid, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Bottom: Actions + Totals -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="305"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,8,0">
                    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Content="New Sale" Command="{Binding NewSaleCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                        <Button Content="Save Sale" Command="{Binding SaveCommand}"
                                Style="{StaticResource SuccessButton}" FontSize="14" Margin="0,0,8,8"/>
                        <Button Content="Print" Command="{Binding PrintCommand}"
                                Style="{StaticResource PurpleButton}" Margin="0,0,8,8"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}"
                                Style="{StaticResource WarningButton}" Margin="0,0,8,8"/>
                        <Button Content="Close" Click="Exit_Click"
                                Style="{StaticResource NeutralButton}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ElevatedCardBorder}" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Bill discount" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding DiscountOnBill, UpdateSourceTrigger=PropertyChanged}"  Width="110"
                                     HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,4,0,6"/>
                        <Grid Margin="0,5,0,5">
                            <TextBlock Text="Total" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding TotalBill, Converter={StaticResource MoneyConverter}, Mode=OneWay}"
                                     Style="{StaticResource TotalDisplay}" Width="170" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Cash received" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding ReceiveCash, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" FontWeight="SemiBold" Padding="6" Width="170"
                                     HorizontalAlignment="Right" TextAlignment="Right"
                                     BorderBrush="{DynamicResource SuccessBrush}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Change / balance" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding Balance, Converter={StaticResource MoneyConverter}, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyFigure}" Width="170" HorizontalAlignment="Right"
                                     Foreground="{DynamicResource InfoTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
