<Window x:Class="POSApp.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSApp.UI.Views"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Login}"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/POSApp.UI;component/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FocusManager.FocusedElement="{Binding ElementName=txtUsername}">

    <!-- Margin leaves room for the drop shadow inside the transparent window -->
    <Border Margin="14" Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="18" Opacity="0.18" Direction="270" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Brand accent strip -->
            <Border Grid.Row="0" Background="{DynamicResource BrandPrimaryBrush}" CornerRadius="14,14,0,0"/>

            <Grid Grid.Row="1" Margin="36,28,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"
                            Background="{DynamicResource BrandSubtleBrush}">
                        <TextBlock Text="🛒" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{helpers:ShopTitle}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <TextBlock Text="Sign in to continue" Style="{StaticResource HintText}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Username" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="txtUsername" helpers:Input.Placeholder="Enter your username"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8"
                             KeyDown="TxtUsername_KeyDown"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Text="Password" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="txtPassword" helpers:Input.Placeholder="Enter your password" FontSize="14" Padding="10,8"
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 KeyDown="TxtPassword_KeyDown"/>
                </StackPanel>

                <!-- Error Message -->
                <Border Grid.Row="3" Style="{StaticResource DangerCallout}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Row="5">
                    <Button Content="Sign in" Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="44" FontSize="14" HorizontalAlignment="Stretch"/>
                    <Button Content="Exit" Command="{Binding CancelCommand}"
                            Style="{StaticResource IconButton}" Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Padding="16,4"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
