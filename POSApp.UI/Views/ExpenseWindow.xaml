<Window x:Class="POSApp.UI.Views.ExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        Title="{helpers:ShopTitle Expense Tracking}" Height="850" Width="1400"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="20">
            <Grid>
                <TextBlock Text="Expense Tracking &amp; Analytics" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>

        <!-- Quick Period Buttons -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="10,10,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Quick Filters" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                <WrapPanel Grid.Row="1">
                    <Button Content="Daily" Command="{Binding SetDailyCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="Weekly" Command="{Binding SetWeeklyCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="Monthly" Command="{Binding SetMonthlyCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="Yearly" Command="{Binding SetYearlyCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                    <Button Content="Custom range" Command="{Binding SetCustomCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="110"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Expense List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PeriodDescription}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Category:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding FilterCategories}"
                                      SelectedItem="{Binding SelectedFilterCategory}"
                                      DisplayMemberPath="Name"
                                      MinWidth="180" Padding="6" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Navigator / Custom Range -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <!-- Navigation arrows (non-custom) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowDateNavigator, Converter={StaticResource BoolToVis}}">
                            <Button Content="◀" Command="{Binding PreviousPeriodCommand}"
                                    Width="34" Height="30" Padding="0"
                                    Style="{StaticResource NeutralButton}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding PeriodDescription}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MinWidth="240" TextAlignment="Center"/>
                            <Button Content="▶" Command="{Binding NextPeriodCommand}"
                                    Width="34" Height="30" Padding="0"
                                    Style="{StaticResource NeutralButton}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Custom date range pickers -->
                        <Border Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="From:" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding CustomStartDate}"
                                            FontSize="14" Padding="8" Margin="0,0,15,0"/>
                                <TextBlock Grid.Column="2" Text="To:" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker Grid.Column="3" SelectedDate="{Binding CustomEndDate}"
                                            FontSize="14" Padding="8"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Expenses}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" HeadersVisibility="All"
                              GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / Time" Binding="{Binding Date, Converter={StaticResource DateConverter}, ConverterParameter=time}" Width="160"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category.Name, TargetNullValue='—'}" Width="140"/>
                            <DataGridTextColumn Header="{x:Static helpers:Region.AmountLabel}" Binding="{Binding Amount, Converter={StaticResource NumberConverter}}" Width="130"
                                                ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="160"/>
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}" Padding="6,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel: Summary + Add Form -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <!-- Summary -->
                        <TextBlock Text="Summary" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>

                        <Border Style="{StaticResource StatTile}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Total Expenses" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource MoneyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Add Expense Form -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,5,0,0">
                            <StackPanel>
                                <TextBlock Text="Add Expense" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                                <TextBlock Text="Description *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13" Margin="0,0,0,12"/>

                                <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategory}"
                                          DisplayMemberPath="Name"
                                          Padding="6" FontSize="13" Margin="0,0,0,12"/>

                                <TextBlock Text="{x:Static helpers:Region.AmountLabelRequired}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13" TextAlignment="Right" Margin="0,0,0,12"/>

                                <TextBlock Text="Note (Optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13" Margin="0,0,0,20" Height="65"
                                         TextWrapping="Wrap" AcceptsReturn="True"/>

                                <Button Content="Add Expense" Command="{Binding AddExpenseCommand}"
                                        Style="{StaticResource SuccessButton}" Padding="12,10" FontSize="14" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Manage Categories -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Manage Categories" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                <ListBox ItemsSource="{Binding Categories}"
                                         SelectedItem="{Binding SelectedManageCategory}"
                                         DisplayMemberPath="Name"
                                         Height="120" FontSize="13" Margin="0,0,0,10"/>

                                <TextBlock Text="Name *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CategoryNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13" Margin="0,0,0,10"/>

                                <TextBlock Text="Description (Optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CategoryDescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13" Margin="0,0,0,12"/>

                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button Content="Add New" Command="{Binding AddCategoryCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="8,8" Margin="0,0,4,0"/>
                                    <Button Content="Update" Command="{Binding UpdateCategoryCommand}"
                                            Style="{StaticResource InfoButton}" Padding="8,8" Margin="4,0,0,0"/>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="Delete" Command="{Binding DeleteCategoryCommand}"
                                            Style="{StaticResource DangerButton}" Padding="8,8" Margin="0,0,4,0"/>
                                    <Button Content="Clear" Command="{Binding ClearCategoryFormCommand}"
                                            Style="{StaticResource NeutralButton}" Padding="8,8" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="10,0,10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Print Report" Command="{Binding PrintReportCommand}"
                        Style="{StaticResource InfoButton}" Margin="0,0,10,0" MinWidth="150"
                        FontSize="14"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" MinWidth="120"
                        FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
