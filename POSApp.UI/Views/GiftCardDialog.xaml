<Window x:Class="POSApp.UI.Views.GiftCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        Title="{helpers:ShopTitle Gift Card}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/POSApp.UI;component/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">
    <StackPanel>
        <Border Style="{DynamicResource HeaderBar}" Padding="16,12">
            <TextBlock Text="{Binding [gift.title], Source={x:Static helpers:PhraseBook.Current}}" Style="{DynamicResource HeaderTitle}"/>
        </Border>

        <Border Style="{DynamicResource CardBorder}" Margin="12">
            <StackPanel>
                <TextBlock Text="{Binding [gift.amount], Source={x:Static helpers:PhraseBook.Current}}" Style="{DynamicResource FormLabel}"/>
                <TextBox x:Name="AmountBox" FontSize="18" FontWeight="SemiBold" TextAlignment="Right" Padding="8,6"
                         AutomationProperties.Name="Gift card amount"/>

                <TextBlock Text="{Binding [gift.name], Source={x:Static helpers:PhraseBook.Current}}" Style="{DynamicResource FormLabel}" Margin="0,10,0,0"/>
                <TextBox x:Name="NameBox" MaxLength="60" AutomationProperties.Name="Recipient name"/>

                <TextBlock Text="{Binding [gift.hint], Source={x:Static helpers:PhraseBook.Current}}"
                           Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceAltBrush}" Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="{Binding [gift.cancel], Source={x:Static helpers:PhraseBook.Current}}"
                        Style="{DynamicResource NeutralButton}" IsCancel="True" HorizontalAlignment="Left" Padding="18,8"/>
                <Button Content="{Binding [gift.add], Source={x:Static helpers:PhraseBook.Current}}"
                        Style="{DynamicResource PrimaryButton}" IsDefault="True" HorizontalAlignment="Right" Padding="18,8" Click="Add_Click"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
