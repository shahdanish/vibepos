<Window x:Class="POSApp.UI.Views.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Restore" Height="620" Width="700"
        WindowStartupLocation="CenterOwner" Icon="/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource HeaderTitle}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,0">
                <!-- Where backups go -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Backup folder" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BackupDirectory}" IsReadOnly="True" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding SelectBackupDirectoryCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Create Backup" Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                            <Button Content="Restore Latest Backup" Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource DangerTonalButton}"/>
                        </WrapPanel>
                        <TextBlock Text="Restoring replaces all current data with the latest backup."
                                   Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Existing backups -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Available backups" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            <Button Content="🔄  Refresh" Command="{Binding RefreshBackupsCommand}"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListView ItemsSource="{Binding AvailableBackups}" Height="150"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="4,2"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" Padding="20,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource NeutralButton}"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
