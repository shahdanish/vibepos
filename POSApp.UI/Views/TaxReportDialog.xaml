<Window x:Class="POSApp.UI.Views.TaxReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        Title="{helpers:ShopTitle Sales Tax Report}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/POSApp.UI;component/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">
    <StackPanel>
        <Border Style="{StaticResource HeaderBar}" Padding="16,10">
            <StackPanel>
                <TextBlock Text="Sales tax report" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="Taxable, non-taxable and exempt sales and the tax collected, for your sales-tax return."
                           Foreground="{DynamicResource OnBrandMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="12">
            <StackPanel>
                <TextBlock Text="Period" Style="{StaticResource FormLabel}"/>
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="This month" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,4" Click="Period_Click" Tag="ThisMonth"/>
                    <Button Content="Last month" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,4" Click="Period_Click" Tag="LastMonth"/>
                    <Button Content="This quarter" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,4" Click="Period_Click" Tag="ThisQuarter"/>
                    <Button Content="Last quarter" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,4" Click="Period_Click" Tag="LastQuarter"/>
                    <Button Content="This year" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,4" Click="Period_Click" Tag="ThisYear"/>
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="From" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="FromDate" AutomationProperties.Name="From"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="To" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="ToDate" AutomationProperties.Name="To"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceAltBrush}" Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Close" Style="{StaticResource NeutralButton}" IsCancel="True" Padding="18,8"/>
                <Button DockPanel.Dock="Right" Content="Show report" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Padding="20,8" Click="Show_Click"/>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
