<Window x:Class="POSApp.UI.Views.BusinessSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        Title="{helpers:ShopTitle Business Settings}" Height="700" Width="860"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/POSApp.UI;component/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- One accent colour card on the Appearance tab -->
        <Style x:Key="AccentChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="GroupName" Value="Accent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                                CornerRadius="8" Padding="12,10" MinWidth="160">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource BrandSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Business Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Everything that changes from one shop or country to the next. Set it once — no rebuild, no developer."
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- ════════════════ SHOP IDENTITY ════════════════ -->
            <TabItem Header="  Shop Identity  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Printed at the top and bottom of every bill, receipt and report, and shown in every window title."
                                   Style="{StaticResource Hint}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shop Name *" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtStoreName" Style="{StaticResource Field}"/>
                                <TextBlock Text="The big line on every printout, and the name in every window title."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtStoreAddress"
                                     Style="{StaticResource Field}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtStorePhone"
                                     Style="{StaticResource Field}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tax / Reg. Number" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtHeaderNote" Style="{StaticResource Field}"/>
                                <TextBlock Text="Your own registration line — EIN or state tax ID (US), VAT or TRN (Gulf/EU), GSTIN (India), NTN / STRN (Pakistan). Leave empty to skip it."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Closing Message" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtFooterMessage"
                                     Style="{StaticResource Field}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Small Note" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="5" Grid.Column="1">
                                <TextBox x:Name="txtFooterNote" Style="{StaticResource Field}"/>
                                <TextBlock Text="Printed small and grey under the closing message. Leave empty to skip."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ CURRENCY ════════════════ -->
            <TabItem Header="  Currency  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Applies to every amount in the software — sales, purchases, customer accounts, expenses, reports, salary slips and receipts."
                                   Style="{StaticResource Hint}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Currency Symbol *" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtCurrencySymbol" Style="{StaticResource Field}" MaxLength="8"/>
                                <TextBlock Text="$  ·  €  ·  £  ·  AED  ·  Rs.  ·  ₹  ·  ৳  ·  kr  ·  ₦"
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Currency Name" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtCurrencyName" Style="{StaticResource Field}"/>
                                <TextBlock Text="Spelled out in the amount-in-words line on salary slips — Rupees, Dollars, Pounds, Dirhams."
                                           Style="{StaticResource Hint}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Currency code" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBox x:Name="txtCurrencyCode" Style="{StaticResource Field}" Width="80" MaxLength="3"
                                             CharacterCasing="Upper"/>
                                    <TextBlock Text="USD · EUR · AED · PKR" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Symbol Position" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboSymbolSide"
                                      Style="{StaticResource Picker}" Margin="0,0,0,10"
                                      SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Before the amount    →  $1,250.00"/>
                                <ComboBoxItem Content="After the amount     →  1,250.00 kr"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Symbol Spacing" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboSymbolSpacing"
                                      Style="{StaticResource Picker}" Margin="0,0,0,10"
                                      SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="With a space    →  Rs. 1,250.00   (Pakistan)"/>
                                <ComboBoxItem Content="No space        →  $1,250.00   (United States)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Decimal Places" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="cboDecimals" Style="{StaticResource Picker}"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="0   →  1,250          (JPY, KRW, UGX)"/>
                                    <ComboBoxItem Content="1   →  1,250.0"/>
                                    <ComboBoxItem Content="2   →  1,250.00       (most currencies)"/>
                                    <ComboBoxItem Content="3   →  1,250.000      (KWD, BHD, OMR)"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Prices On Bills" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="cboCompactDecimals" Style="{StaticResource Picker}"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Whole numbers    →  23     1,251"/>
                                    <ComboBoxItem Content="With decimals    →  3.49   1,250.50   (United States)"/>
                                </ComboBox>
                                <TextBlock Text="The narrow price, cost and discount columns of a printed bill, and the shift and dashboard tallies."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Number Format" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cboNumberFormat"
                                      Style="{StaticResource Picker}" Margin="0,0,0,10"
                                      SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="1,234.56    (US, UK, India, Pakistan)"/>
                                <ComboBoxItem Content="1.234,56    (Germany, Italy, Spain, Brazil)"/>
                                <ComboBoxItem Content="1 234.56    (space grouping)"/>
                                <ComboBoxItem Content="1 234,56    (France, Scandinavia)"/>
                            </ComboBox>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Amount In Words" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="7" Grid.Column="1">
                                <ComboBox x:Name="cboNumberWords" Style="{StaticResource Picker}"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Million / Billion    (most countries)"/>
                                    <ComboBoxItem Content="Lakh / Crore         (Pakistan, India, Bangladesh)"/>
                                </ComboBox>
                                <TextBlock Text="Used on the salary slip where the net pay is written out in words."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ REGIONAL ════════════════ -->
            <TabItem Header="  Regional  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="The country you trade in, the date order, and the local names for identity documents and payroll deductions."
                                   Style="{StaticResource Hint}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Country" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="cboRegion" Style="{StaticResource Picker}"
                                          SelectionChanged="Region_Changed">
                                    <ComboBoxItem Content="United States"/>
                                    <ComboBoxItem Content="Pakistan"/>
                                    <ComboBoxItem Content="Other country"/>
                                </ComboBox>
                                <TextBlock Text="Choosing United States or Pakistan fills in that country's usual currency, number and date settings on these tabs. You can still change each one afterwards."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date Format" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="cboDateStyle" Style="{StaticResource Picker}"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="Day first    →  31/12/2026   (most of the world)"/>
                                    <ComboBoxItem Content="Month first  →  12/31/2026   (United States)"/>
                                    <ComboBoxItem Content="ISO          →  2026-12-31   (unambiguous)"/>
                                </ComboBox>
                                <TextBlock Text="Applies to every date column, report filter and printed receipt."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Time Format" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboTimeStyle"
                                      Style="{StaticResource Picker}" Margin="0,0,0,10"
                                      SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="12-hour  →  02:35 PM"/>
                                <ComboBoxItem Content="12-hour  →  2:35 PM    (United States)"/>
                                <ComboBoxItem Content="24-hour  →  14:35"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ID Document Name" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtNationalIdLabel" Style="{StaticResource Field}"/>
                                <TextBlock Text="The employee identity field label — ID Number (US), National Insurance No. (UK), Emirates ID (UAE), Aadhaar (India), CNIC (Pakistan)."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Payroll Deduction" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBox x:Name="txtStatutoryDeductionLabel" Style="{StaticResource Field}"/>
                                <TextBlock Text="The compulsory salary deduction in your country — Social Security (US), NI (UK), Pension (UAE), PF (India), EOBI (Pakistan)."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ SALES TAX (US) ════════════════ -->
            <TabItem x:Name="SalesTaxTab" Header="  Sales Tax  " Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Sales tax added to US sales. Give each category the combined state + local rate you collect, and 0% for items your state does not tax (prescription drugs, and in many states groceries or non-prescription drugs). Your state's tax agency has the rates that apply to you."/>

                        <CheckBox x:Name="chkTaxEnabled" Content="Charge sales tax on sales" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <DataGrid x:Name="gridTaxCategories" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="180"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="Rate %" Binding="{Binding RateText, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="The default category applies to every product that has no tax category of its own (set one on the product in Inventory → Products)."/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="+ Add category" Click="AddTaxCategory_Click" Padding="12,5" Margin="0,0,8,0"/>
                            <Button Content="Remove selected" Click="RemoveTaxCategory_Click" Padding="12,5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ PHARMACY (US front store) ════════════════ -->
            <TabItem x:Name="PharmacyTab" Header="  Pharmacy  " Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Rules for the pharmacy front store. Your state may set stricter pseudoephedrine limits or require an electronic tracking system — this program keeps a local logbook only and does not connect to one."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="PSE limit per day (g base)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtPseDaily" Style="{StaticResource Field}" Width="120" HorizontalAlignment="Left"
                                         AutomationProperties.Name="PSE daily limit"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Per purchaser. The federal amount is 3.6 g."/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="PSE limit per 30 days (g base)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <TextBox x:Name="txtPse30" Style="{StaticResource Field}" Width="120" HorizontalAlignment="Left"
                                         AutomationProperties.Name="PSE 30-day limit"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Per purchaser. The federal amount is 9 g."/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Expired products" Style="{StaticResource FieldLabel}"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkBlockExpired"
                                      Content="Refuse to sell a product past its expiry date"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ CARD PAYMENTS (US) ════════════════ -->
            <TabItem x:Name="PaymentsTab" Header="  Card Payments  " Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="With an integrated reader the bill total goes to the reader by itself — nothing to key in twice, and the card brand, last four digits and approval code print on the receipt. Card numbers stay on the reader and with the processor; they never pass through this computer."/>

                        <RadioButton x:Name="rbCardSeparate" GroupName="CardReader" Margin="0,0,0,6" Checked="CardReaderChoice_Changed"
                                     Content="Separate card machine — key the amount in on it, then choose Card here"/>
                        <RadioButton x:Name="rbCardStripe" GroupName="CardReader" Margin="0,0,0,12" Checked="CardReaderChoice_Changed"
                                     Content="Stripe Terminal smart reader (connected over the internet)"/>

                        <Grid x:Name="StripePanel" Margin="20,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Secret key" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <PasswordBox x:Name="pwdStripeKey" Padding="6,4" FontSize="13" HorizontalAlignment="Stretch"
                                             AutomationProperties.Name="Stripe secret key"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Stripe dashboard → Developers → API keys. Starts with sk_live_ (or sk_test_ to try it out with no real money). Saved encrypted, for this computer only."/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Reader" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="cboCardReader" Style="{StaticResource Picker}" Width="260" AutomationProperties.Name="Card reader"/>
                                    <Button Content="Find readers" Click="FindReaders_Click" Padding="12,5" Margin="10,0,0,0"/>
                                    <Button x:Name="btnTestReader" Content="Set up a test reader" Click="TestReader_Click" Padding="12,5" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Register the reader to your Stripe account first (Stripe dashboard → Terminal → Readers). The test reader works with sk_test_ keys only."/>
                                <TextBlock x:Name="txtPaymentsStatus" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Text="Stripe charges its own processing fees under your agreement with Stripe. Refunds of reader payments go back to the same card from Sale Return."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ DEVICES (this PC) ════════════════ -->
            <TabItem Header="  Devices  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Hardware on this computer. Barcode scanners need no setup — they type like a keyboard."/>

                        <TextBlock Text="Cash drawer" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                        <CheckBox x:Name="chkCashDrawer" Content="Open the cash drawer after cash sales (Ctrl+D opens it without a sale)"
                                  Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Receipt printer" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                <ComboBox x:Name="cboDrawerPrinter" Style="{StaticResource Picker}" AutomationProperties.Name="Cash drawer printer"/>
                                <TextBlock Style="{StaticResource Hint}" Text="The printer the drawer cable plugs into (usually the receipt printer)."/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Drawer connector" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="cboDrawerPin" Style="{StaticResource Picker}" Width="200">
                                    <ComboBoxItem Content="Pin 2 (most drawers)"/>
                                    <ComboBoxItem Content="Pin 5"/>
                                </ComboBox>
                                <Button Content="Test drawer" Click="TestDrawer_Click" Padding="12,5" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ APPEARANCE ════════════════ -->
            <TabItem Header="  Appearance  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="How the screens look for you on this computer. Receipts are not affected. Changes show straight away — press Save to keep them, or Close to go back."
                                   Style="{StaticResource Hint}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Accent Colour" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top" Margin="0,10,10,10"/>
                            <WrapPanel Grid.Row="0" Grid.Column="1" x:Name="AccentChoices" Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Density" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                <ComboBox x:Name="cboDensity" Style="{StaticResource Picker}"
                                          SelectionChanged="Density_Changed">
                                    <ComboBoxItem Content="Comfortable  →  standard size"/>
                                    <ComboBoxItem Content="Compact  →  90% size, fits more on small screens"/>
                                </ComboBox>
                                <TextBlock Text="Compact suits 1366×768 and smaller LED screens."
                                           Style="{StaticResource Hint}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sample" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top" Margin="0,10,10,10"/>
                            <Border Grid.Row="2" Grid.Column="1" Style="{DynamicResource CardBorder}" Padding="0"
                                    Margin="0" HorizontalAlignment="Left" MinWidth="420">
                                <StackPanel>
                                    <Border Style="{DynamicResource HeaderBar}" Padding="14,8">
                                        <TextBlock Text="Point of Sale" Style="{DynamicResource HeaderTitle}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="14,14,14,8">
                                        <Button Style="{DynamicResource QuickTile}" Focusable="False">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0" LastChildFill="False">
                                                    <Border DockPanel.Dock="Left" Style="{DynamicResource KeyCap}" Margin="0" Padding="4,0">
                                                        <TextBlock Text="F1" FontSize="10"/>
                                                    </Border>
                                                    <Border DockPanel.Dock="Right" Style="{DynamicResource QuickTileBadge}"
                                                            Background="{DynamicResource WarningSubtleBrush}">
                                                        <TextBlock Text="Low · 3" Foreground="{DynamicResource WarningTextBrush}"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="Sample item" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,2"/>
                                                <TextBlock Grid.Row="2" x:Name="txtSampleTilePrice" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                            </Grid>
                                        </Button>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Button Content="Pay" Style="{DynamicResource PrimaryButton}" Padding="22,8"
                                                        Margin="0,0,8,0" Focusable="False"/>
                                                <Button Content="Hold" Style="{DynamicResource SecondaryButton}" Padding="16,8"
                                                        Focusable="False"/>
                                            </StackPanel>
                                            <CheckBox Content="Auto print" IsChecked="True" Focusable="False"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════ PREVIEW ════════════════ -->
            <TabItem Header="  Preview  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Exactly how a receipt will print with the settings currently on screen. Press Refresh after changing anything."
                                   Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                        <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}"
                                Padding="16" HorizontalAlignment="Center" MinWidth="300">
                            <StackPanel>
                                <TextBlock x:Name="txtPreviewHeader" TextAlignment="Center" TextWrapping="Wrap"
                                           FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Margin="0,10" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="txtPreviewDate" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="txtPreviewLine1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="txtPreviewLine2" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="txtPreviewTotal" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="txtPreviewWords" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="txtPreviewFooter" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceSunkenBrush}" Padding="12" Margin="0,15,0,0" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Labels elsewhere in the software" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="txtPreviewLabels" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Content="↻  Refresh Preview" Click="RefreshPreview_Click"
                                HorizontalAlignment="Left" Padding="14,6" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="txtStatus" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Restore Defaults" Click="RestoreDefaults_Click" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Save" Click="Save_Click" Padding="30,8" Margin="0,0,10,0"
                        Background="{DynamicResource SuccessBrush}" Foreground="White"/>
                <Button Content="Close" Click="Close_Click" Padding="20,8" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
