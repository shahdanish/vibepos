<Window x:Class="POSApp.UI.Views.ReportViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="760" Width="620" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/POSApp.UI;component/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The report as it will print; it scrolls on small screens -->
        <Border Grid.Row="0" Margin="12,12,12,0" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" Padding="12,10" Margin="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Close" Style="{DynamicResource NeutralButton}" IsCancel="True" Padding="18,8"/>
                <Button DockPanel.Dock="Right" x:Name="PrintButton" Content="🖨  Print" Style="{DynamicResource PrimaryButton}"
                        Padding="20,8" Margin="8,0,0,0" Click="Print_Click"/>
                <Button DockPanel.Dock="Right" x:Name="ExportButton" Content="Export CSV" Style="{DynamicResource SecondaryButton}"
                        Padding="16,8" Click="Export_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
