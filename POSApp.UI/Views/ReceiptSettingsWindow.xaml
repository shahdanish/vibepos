<Window x:Class="POSApp.UI.Views.ReceiptSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt &amp; Region Settings" Height="720" Width="760"
        WindowStartupLocation="CenterOwner" Icon="/app-icon.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Receipt &amp; Region Settings" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Shop details, currency and regional labels. Set them once per shop — no rebuild needed."
                       FontSize="12" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Header (printed at the TOP of every printout)" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Shop Name"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtStoreName"
                                   Padding="6,5" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Address"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtStoreAddress"
                                   Padding="6,5" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone Number"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtStorePhone"
                                   Padding="6,5" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Extra Header Line"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBox x:Name="txtHeaderNote" Padding="6,5" FontSize="14"/>
                            <TextBlock Text="Optional — e.g. NTN / STRN number, tagline, or a second phone. Leave empty to skip."
                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Footer (printed at the BOTTOM of every printout)" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Closing Message"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtFooterMessage"
                                   Padding="6,5" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Small Note"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBox x:Name="txtFooterNote" Padding="6,5" FontSize="14"/>
                            <TextBlock Text="Optional — printed small and grey under the closing message. Leave empty to skip."
                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Currency &amp; Region (used everywhere in the software)" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Currency Symbol"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox x:Name="txtCurrencySymbol" Padding="6,5" FontSize="14"/>
                            <TextBlock Text="Printed before every amount — e.g. Rs.  $  £  AED  ₹"
                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Currency Name"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox x:Name="txtCurrencyName" Padding="6,5" FontSize="14"/>
                            <TextBlock Text="Spelled out on salary slips — e.g. Rupees, Dollars, Dirhams"
                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Amount In Words"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <ComboBox x:Name="cboNumberWords" Padding="6,5" FontSize="14">
                                <ComboBoxItem Content="Million / Billion (most countries)"/>
                                <ComboBoxItem Content="Lakh / Crore (Pakistan, India, Bangladesh)"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ID Document Name"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,8"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                            <TextBox x:Name="txtNationalIdLabel" Padding="6,5" FontSize="14"/>
                            <TextBlock Text="The employee ID field label — e.g. CNIC, National ID, Emirates ID, SSN"
                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Payroll Deduction"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <TextBox x:Name="txtStatutoryDeductionLabel" Padding="6,5" FontSize="14"/>
                            <TextBlock Text="The compulsory salary deduction in your country — e.g. EOBI, Social Security, NI"
                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Preview" Padding="15">
                    <StackPanel>
                        <Border BorderBrush="#CCC" BorderThickness="1" Background="White" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="txtPreviewHeader" TextAlignment="Center" TextWrapping="Wrap"
                                           FontWeight="Bold" FontSize="15"/>
                                <Border BorderBrush="#DDD" BorderThickness="0,1,0,1" Margin="0,8" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="… bill items …" TextAlignment="Center"
                                                   Foreground="Gray" FontSize="11"/>
                                        <TextBlock x:Name="txtPreviewTotal" TextAlignment="Center"
                                                   FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="txtPreviewFooter" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Refresh Preview" Click="RefreshPreview_Click"
                                HorizontalAlignment="Left" Padding="12,5" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock x:Name="txtStatus" FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Restore Defaults" Click="RestoreDefaults_Click" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Save" Click="Save_Click" Padding="25,8" Margin="0,0,10,0"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button Content="Close" Click="Close_Click" Padding="20,8"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
