<UserControl x:Class="POSApp.UI.Views.QuickKeysPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:POSApp.UI.Helpers">
    <!-- Quick keys: one-click tiles for the shop's starred products (DataContext: SaleViewModel). -->
    <Border Style="{StaticResource CardBorder}" Padding="10" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Hide" Style="{StaticResource NeutralButton}"
                        Padding="10,3" Margin="6,0,0,0" Command="{Binding ToggleShowQuickKeysCommand}"
                        ToolTip="Hide the quick keys (show them again with the ★ button above the cart)"/>
                <Button DockPanel.Dock="Right" Content="Manage" Style="{StaticResource SecondaryButton}"
                        Padding="10,3" Click="Manage_Click"
                        ToolTip="Reorder or remove quick keys"/>
                <TextBlock Text="Quick keys" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBox Grid.Row="1" Margin="0,0,0,8"
                     Text="{Binding QuickKeySearch, UpdateSourceTrigger=PropertyChanged}"
                     helpers:Input.Placeholder="Filter quick keys"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <ItemsControl x:Name="Tiles" ItemsSource="{Binding QuickKeys}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource QuickTile}" ToolTip="{Binding ToolTipText}"
                                        Command="{Binding DataContext.AddQuickKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Hot key on the left, stock warning on the right -->
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <Border DockPanel.Dock="Left" Style="{StaticResource KeyCap}" Margin="0"
                                                    Padding="4,0"
                                                    Visibility="{Binding HasHotKey, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding HotKey}" FontSize="10"/>
                                            </Border>
                                            <Border x:Name="StockBadge" DockPanel.Dock="Right" Style="{StaticResource QuickTileBadge}"
                                                    Background="{DynamicResource WarningSubtleBrush}"
                                                    Visibility="{Binding HasStockBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock x:Name="StockText" Text="{Binding StockBadge}"
                                                           Foreground="{DynamicResource WarningTextBrush}"/>
                                            </Border>
                                        </DockPanel>

                                        <!-- Two lines, so long medicine names keep their strength ("Acetaminophen 500 mg …") -->
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" FontSize="11.5" FontWeight="SemiBold"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center" MaxHeight="30" Margin="0,1"/>

                                        <TextBlock Grid.Row="2" Text="{Binding PriceText}" FontSize="12"
                                                   FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                        <Setter TargetName="StockBadge" Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                        <Setter TargetName="StockText" Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource EmptyStateText}" Margin="8,24,8,8"
                               Visibility="{Binding HasItems, ElementName=Tiles, Converter={StaticResource InverseBoolToVis}}"
                               Text="No quick key matches the filter."/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
