<Window x:Class="POSApp.UI.Views.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSApp.UI.Views"
        xmlns:conv="clr-namespace:POSApp.UI.Converters"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Product Management}" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <TextBlock Text="Product Management" FontSize="20" FontWeight="SemiBold" 
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Product List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Products List" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Width="260" Padding="8,6" Margin="0,0,0,8"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 ToolTip="Search across all columns — barcode, name, category, prices, stock, rack, batch, expiry"
                         helpers:Input.Placeholder="🔍  Search products…"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="☆" Width="34" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleQuickKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Cursor="Hand" Focusable="False"
                                                AutomationProperties.Name="Quick key">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" Padding="2,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="☆"/>
                                                    <Setter Property="FontSize" Value="16"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="ToolTip" Value="Add to quick keys on the sale screens"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ContainsIdConverter}">
                                                                    <Binding Path="Id"/>
                                                                    <Binding Path="DataContext.QuickKeyIds" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Content" Value="★"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}"/>
                                                            <Setter Property="ToolTip" Value="Remove from quick keys"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="125"/>
                            <DataGridTemplateColumn Header="Product Name" Width="*" SortMemberPath="ProductName">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="ToolTip" Value="{Binding ProductName}"/>
                                        <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Padding="2,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="80"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, Converter={StaticResource NumberConverter}, ConverterParameter=list}" Width="76"/>
                            <DataGridTextColumn Header="Retail" Binding="{Binding UnitPrice, Converter={StaticResource NumberConverter}, ConverterParameter=list}" Width="76"/>
                            <DataGridTextColumn Header="W/Sale" Binding="{Binding WholesalePrice, Converter={StaticResource NumberConverter}, ConverterParameter=list}" Width="74"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="50"/>
                            <DataGridTextColumn Header="Rack" Binding="{Binding Rack}" Width="40"/>
                            <DataGridTextColumn x:Name="BatchColumn" Header="Batch No" Binding="{Binding BatchNo}" Width="68"/>
                            <DataGridTextColumn x:Name="ExpiryColumn" Header="Expiry" Binding="{Binding ExpiryDate, Converter={StaticResource DateConverter}, ConverterParameter=monthyear}" Width="62"/>
                            <DataGridTemplateColumn Header="Status" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsDeleted, Converter={StaticResource BoolToBackground}}" 
                                                CornerRadius="3" Padding="5,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding IsDeleted, Converter={StaticResource BoolToText}}" 
                                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="Show Deleted" IsChecked="{Binding ShowDeletedProducts}" 
                                  FontSize="13" FontWeight="SemiBold"
                                  ToolTip="Toggle to show/hide deleted products" Margin="0,0,10,0"/>
                        <Button Content="Refresh List" Command="{Binding RefreshCommand}" 
                                Style="{StaticResource SecondaryButton}" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Add/Edit Form -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Product Details" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Barcode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BarcodeBox"
                                     Grid.Column="0"
                                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8"
                                     ToolTip="Scan or type a barcode, or click Auto to generate one."
                                     LostFocus="BarcodeBox_LostFocus"/>
                            <Button Grid.Column="1"
                                    Content="Auto"
                                    Command="{Binding GenerateBarcodeCommand}"
                                    Style="{StaticResource InfoButton}"
                                    Padding="10,8" Margin="6,0,0,0"
                                    ToolTip="Generate a unique numeric barcode"/>
                        </Grid>

                        <TextBlock Text="Product Name *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                        <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                                  DisplayMemberPath="Name" Padding="8" Margin="0,0,0,10"/>

                        <!-- US sales tax class (only when the shop has tax categories) -->
                        <StackPanel Visibility="{Binding HasTaxCategories, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Tax category" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding TaxCategoryChoices}" SelectedItem="{Binding SelectedTaxCategory}"
                                      DisplayMemberPath="Label" Padding="8" Margin="0,0,0,10"
                                      AutomationProperties.Name="Tax category"/>
                        </StackPanel>

                        <TextBlock Text="{x:Static helpers:Region.CostPriceLabel}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=LostFocus, TargetNullValue='', StringFormat=0.##}"
                                 Padding="8" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static helpers:Region.RetailPriceLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource WarningBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    Visibility="{Binding IsPharmacyUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Auto −15%" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, TargetNullValue='', StringFormat=0.##}"
                                 Padding="8" Margin="0,0,0,10"/>

                        <TextBlock Text="{x:Static helpers:Region.WholesalePriceLabel}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding WholesalePrice, UpdateSourceTrigger=LostFocus, TargetNullValue='', StringFormat=0.##}"
                                 Padding="8" Margin="0,0,0,10"/>

                        <TextBlock Text="Stock Quantity" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Padding="8" Margin="0,0,0,10"/>

                        <TextBlock Text="Low Stock Alert (qty)" FontWeight="SemiBold" Margin="0,0,0,5"
                                   ToolTip="Product appears in Dashboard low-stock alerts when stock falls to or below this number"/>
                        <TextBox Text="{Binding MinStockThreshold, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Padding="8" Margin="0,0,0,10"/>

                        <TextBlock Text="Rack/Location" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Rack, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                        <!-- Pharmacy-only fields -->
                        <StackPanel Visibility="{Binding PharmacyFieldsVisibility}">
                            <TextBlock Text="Batch No" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"/>

                            <TextBlock Text="Expiry Date" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding ExpiryDate}" Margin="0,0,0,15"
                                        DisplayDateStart="2020-01-01"/>
                        </StackPanel>

                        <!-- US front store: ID check, FSA/HSA, pseudoephedrine -->
                        <StackPanel Visibility="{Binding ShowFrontStoreFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ID check at the register" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox SelectedIndex="{Binding MinimumAgeIndex}" Padding="8" Margin="0,0,0,10"
                                      AutomationProperties.Name="ID check">
                                <ComboBoxItem Content="No ID check"/>
                                <ComboBoxItem Content="18+ (nicotine replacement, cough medicine with DXM in many states)"/>
                                <ComboBoxItem Content="21+ (tobacco)"/>
                            </ComboBox>
                            <StackPanel Visibility="{Binding ShowPharmacyFields, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="FSA/HSA eligible" IsChecked="{Binding IsFsaEligible}" Margin="0,0,0,8"/>
                                <CheckBox Content="Contains pseudoephedrine / ephedrine (PSE logbook)" IsChecked="{Binding IsPse}" Margin="0,0,0,6"/>
                                <StackPanel Visibility="{Binding IsPse, Converter={StaticResource BoolToVis}}" Margin="26,0,0,10">
                                    <TextBlock Text="Base drug per package (mg)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding PseBaseMgPerPack, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Padding="8"/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Tablets × mg per tablet × 0.82 for the HCl salt, e.g. 24 × 30 mg = 590 mg. Check the package."/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <Button Content="Add New Product" Command="{Binding AddCommand}" 
                                    Style="{StaticResource SuccessButton}" Padding="10,8" Margin="0,0,0,10"/>
                            <Button Content="Update Product" Command="{Binding UpdateCommand}" 
                                    Style="{StaticResource WarningButton}" Padding="10,8" Margin="0,0,0,10"/>
                            <Button Content="Delete Product" Command="{Binding DeleteCommand}" 
                                    Style="{StaticResource DangerButton}" Padding="10,8" Margin="0,0,0,10"/>
                            <Button Content="Restore Product" Command="{Binding RestoreCommand}" 
                                    Style="{StaticResource RestoreButton}" Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding SelectedProduct.IsDeleted, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                            <Button Content="Clear Form" Command="{Binding ClearCommand}" 
                                    Style="{StaticResource NeutralButton}" Padding="10,8" Margin="0,0,0,10"/>
                            <Button Content="Close" Click="Close_Click" 
                                    Style="{StaticResource NeutralButton}" Padding="10,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
