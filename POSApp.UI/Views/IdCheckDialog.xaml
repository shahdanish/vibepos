<Window x:Class="POSApp.UI.Views.IdCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        Title="{helpers:ShopTitle ID Check}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/POSApp.UI;component/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">
    <StackPanel>
        <Border Style="{StaticResource HeaderBar}" Padding="16,10">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="ID check required" Style="{StaticResource HeaderTitle}"/>
                <TextBlock x:Name="ProductText" Foreground="{DynamicResource OnBrandMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Margin="12">
            <StackPanel>
                <TextBlock Text="Check the customer's photo ID, then enter the date of birth shown on it."
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Date of birth" Style="{StaticResource FormLabel}"/>
                <DatePicker x:Name="Dob" AutomationProperties.Name="Date of birth" SelectedDateChanged="Dob_Changed"/>
                <TextBlock x:Name="AgeText" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceAltBrush}" Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Don't sell" Style="{StaticResource NeutralButton}" IsCancel="True" Padding="18,8"/>
                <Button DockPanel.Dock="Right" x:Name="ConfirmButton" Content="ID checked — sell" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" IsEnabled="False" Padding="20,8" Click="Confirm_Click"/>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
