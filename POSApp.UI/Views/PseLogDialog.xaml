<Window x:Class="POSApp.UI.Views.PseLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        Title="{helpers:ShopTitle PSE Logbook}" Width="520" Height="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/POSApp.UI;component/app-icon.png"
        Background="{DynamicResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="16,10">
            <StackPanel>
                <TextBlock Text="Pseudoephedrine logbook" Style="{StaticResource HeaderTitle}"/>
                <TextBlock x:Name="ItemsText" Foreground="{DynamicResource OnBrandMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Check the purchaser's photo ID and record it here." TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Purchaser name *" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="PurchaserName" Margin="0,0,0,10" AutomationProperties.Name="Purchaser name"/>

                        <TextBlock Text="Address" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="PurchaserAddress" Margin="0,0,0,10" AutomationProperties.Name="Address"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ID type *" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="IdType" SelectedIndex="0" AutomationProperties.Name="ID type">
                                    <ComboBoxItem Content="Driver license"/>
                                    <ComboBoxItem Content="State ID"/>
                                    <ComboBoxItem Content="Passport"/>
                                    <ComboBoxItem Content="Military ID"/>
                                    <ComboBoxItem Content="Other government ID"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ID number *" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="IdNumber" AutomationProperties.Name="ID number"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Date of birth" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="Dob" AutomationProperties.Name="Date of birth"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultPanel" Style="{StaticResource InfoCallout}" Visibility="Collapsed">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="2,8,2,0"
                           Text="Limits are checked against this shop's own logbook only. Your state may set lower limits or require an electronic tracking system; this program does not connect to one."/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource NeutralButton}" IsCancel="True" Padding="18,8"/>
                <Button DockPanel.Dock="Right" x:Name="ConfirmButton" Content="Check limits and record" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Padding="20,8" Click="Confirm_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
