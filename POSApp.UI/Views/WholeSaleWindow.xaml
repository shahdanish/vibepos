<Window x:Class="POSApp.UI.Views.WholeSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:local="clr-namespace:POSApp.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Whole Sale}" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="12,8">
            <Grid>
                <TextBlock Text="Wholesale" Style="{StaticResource HeaderTitle}" HorizontalAlignment="Left"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#26FFFFFF" CornerRadius="14" Padding="12,4">
                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='Invoice  #{0}'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Quick keys: a full-height rail so the tiles get room even on 1366×768.
                 Only shown once the shop has starred a product, so the screen is unchanged
                 for shops that do not use them. -->
            <local:QuickKeysPanel Grid.Column="1" Grid.RowSpan="3" Width="304" Margin="8,0,0,0"
                                  Visibility="{Binding IsQuickKeysPanelVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Top card -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <!-- Row 1: Customer | Mobile | Payment | Date -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="135"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Customer Name" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Mobile Number" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding MobileNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Payment Method" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Sale Date" Style="{StaticResource FormLabel}"/>
                            <DatePicker SelectedDate="{Binding SaleDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- Credit customer row -->
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsCreditPayment, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Credit Customer" Style="{StaticResource FormLabel}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Outstanding Balance" Style="{StaticResource FormLabel}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBox Text="{Binding PreBalance, Converter={StaticResource MoneyConverter}, Mode=OneWay}"  IsReadOnly="True" Background="{DynamicResource WarningSubtleBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource WarningSubtleBrush}" Padding="8,5" CornerRadius="4"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="⚠ Credit sale — amount added to customer's outstanding balance."
                                       FontSize="11" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                    <!-- Row 2: Bill Note | Barcode | Product | Toggles -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Bill Note (Optional)" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding BillNote, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Scan Barcode" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:Input.Placeholder="Scan or type, then Enter" >
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Select Product" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ProductCombo"
                                      ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      DisplayMemberPath="ProductName" IsEditable="True" IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      PreviewKeyDown="ProductCombo_PreviewKeyDown"
                                      DropDownClosed="ProductCombo_DropDownClosed" />
                        </StackPanel>

                        <!-- Receipt options: labelled like the other fields so the
                             checkboxes sit on the same line as the inputs -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Receipt" Style="{StaticResource FormLabel}"/>
                            <StackPanel Orientation="Horizontal" MinHeight="34">
                                <CheckBox Content="Auto print" IsChecked="{Binding AutoPrint}"
                                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Content="Small bill" IsChecked="{Binding UseSmallBillFormat}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Items Grid -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Sale Items" Style="{StaticResource SectionTitle}"/>
                        <ToggleButton DockPanel.Dock="Right" Content="★  Quick keys" Padding="10,3" Margin="0,0,0,6"
                                      IsChecked="{Binding ShowQuickKeys, Mode=TwoWay}"
                                      Visibility="{Binding HasQuickKeys, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Show or hide the quick-key tiles (F1–F12)"/>
                    </DockPanel>
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" ItemsSource="{Binding SaleItems}" AutoGenerateColumns="False"
                              CanUserAddRows="False" AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                              HeadersVisibility="All" GridLinesVisibility="Horizontal" BorderThickness="0"
                              AlternationCount="99999"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="★  Add to quick keys" Command="{Binding AddItemToQuickKeysCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="☆  Remove from quick keys" Command="{Binding RemoveItemFromQuickKeysCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sr#" IsReadOnly="True" Width="45"
                                                Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Converter={StaticResource RowIndexConverter}}"
                                                ElementStyle="{StaticResource CenterAlignStyle}"/>
                            <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Unit Price" Width="95" ElementStyle="{StaticResource RightAlignStyle}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UnitPrice" StringFormat="N2" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Qty" Width="65" ElementStyle="{StaticResource CenterAlignStyle}">
                                <!-- LostFocus (not PropertyChanged) so decimal quantities like
                                     1.5 / 2.5 / 1.3 can be typed: PropertyChanged reparses each
                                     keystroke and strips the trailing '.' before the fraction. -->
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Quantity" Mode="TwoWay" UpdateSourceTrigger="LostFocus"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Discount" Width="140" SortMemberPath="DiscountPercent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DiscountDisplay}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Padding="6,0" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="4"
                                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                    Margin="0,0,5,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceSunkenBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ToggleButton IsChecked="{Binding DiscountTypeIsPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Width="30" Height="24" Padding="0" FontSize="11"
                                                                  ToolTip="Percentage discount"
                                                                  BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderStrongBrush}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Content" Value="%"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="3,0,0,3">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InfoSubtleBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ToggleButton IsChecked="{Binding DiscountTypeIsAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Width="30" Height="24" Padding="0" FontSize="11"
                                                                  ToolTip="{x:Static helpers:Region.FixedDiscountTooltip}"
                                                                  BorderThickness="0">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Content" Value="{x:Static helpers:Region.Symbol}"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="0,3,3,0">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SuccessSubtleBrush}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                </StackPanel>
                                            </Border>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding DiscountPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Right" 
                                                     VerticalAlignment="Center"
                                                     BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource NumberConverter}}"
                                                IsReadOnly="True" Width="100" ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTemplateColumn Header="Del" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#x1F5D1;" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{StaticResource IconButton}" Foreground="{DynamicResource DangerTextBrush}"
                                                FontSize="13" ToolTip="Remove item"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Scan a barcode or pick a product above to add items"
                               Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding HasItems, ElementName=ItemsGrid, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Bottom: Totals & Actions -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="305"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons + Shortcut Legend -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,8,0">
                    <StackPanel>
                        <WrapPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Button Content="Quick Sale" Command="{Binding QuickSaleCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Ctrl+Q — Open a new wholesale window"/>
                            <Button Content="{Binding ModeSwitchLabel}" Command="{Binding SwitchModeCommand}"
                                    Style="{StaticResource InfoButton}" Margin="0,0,8,8"
                                    ToolTip="Ctrl+W — Switch to Retail Sale mode"/>
                            <Button Content="Save Sale" Command="{Binding SaveCommand}"
                                    Style="{StaticResource SuccessButton}" FontSize="14" Margin="0,0,8,8"
                                    ToolTip="Ctrl+Enter — Save the current sale"/>
                            <Button Content="Print" Command="{Binding PrintCommand}"
                                    Style="{StaticResource PurpleButton}" Margin="0,0,8,8"
                                    ToolTip="Ctrl+P — Print &amp; save invoice"/>
                            <!-- US: pay one bill several ways (cash + card, card + charge account, ...) -->
                            <Button Content="Split…" Click="SplitPayment_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Visibility="{Binding IsUsCheckout, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Ctrl+T — Take this bill in more than one payment"/>
                            <Button Content="New Sale" Command="{Binding NewCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    ToolTip="Ctrl+N — Start a new sale"/>
                            <Button Content="🖩  Calculator" Click="Calculator_Click"
                                    Style="{StaticResource NeutralButton}" Margin="0,0,8,8"
                                    ToolTip="Ctrl+M — Open calculator (keyboard-ready)"/>
                            <Button Content="Close" Click="Exit_Click"
                                    Style="{StaticResource NeutralButton}" Margin="0,0,8,8"
                                    ToolTip="Esc — Close this window"/>
                        </WrapPanel>

                        <!-- The split entered for this bill (US) -->
                        <TextBlock Text="{Binding SplitSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource InfoTextBrush}" Margin="0,0,0,6"
                                   Visibility="{Binding IsSplitPayment, Converter={StaticResource BoolToVis}}"/>

                        <!-- Keyboard shortcut legend -->
                        <Border Margin="0,4,0,0">
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Shortcuts" Style="{StaticResource HintText}" FontWeight="SemiBold"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl+N New"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl+Enter Save"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl+P Print"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl+W Retail"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl+Q Quick"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Ctrl+M Calc"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}"
                                        Visibility="{Binding IsUsCheckout, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Ctrl+T Split"/>
                                </Border>
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Esc Close"/>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Totals -->
                <Border Grid.Column="1" Style="{StaticResource ElevatedCardBorder}" Padding="12">
                    <StackPanel>

                        <!-- Item discounts breakdown (only when > 0) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalItemsDiscount, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBlock Text="Item discounts" FontSize="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalItemsDiscount, Converter={StaticResource MoneyConverter}, ConverterParameter=-}"
                                       FontSize="11" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Bill discount" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding DiscountOnBill, UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource NullableDecimalConverter}}"
                                     FontSize="13" Padding="6" Width="170" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" Margin="0,4,0,6"/>
                        <!-- US sales tax, one line so the cart keeps its height on small screens -->
                        <Grid Margin="0,0,0,2" Visibility="{Binding TaxApplies, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                <Run Text="Subtotal"/>
                                <Run Text="{Binding Subtotal, Converter={StaticResource MoneyConverter}, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="{Binding TaxLabel, Mode=OneWay}"/>
                                <Run Text="{Binding TaxTotal, Converter={StaticResource MoneyConverter}, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,5,0,5">
                            <TextBlock Text="Total" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding TotalBill, Converter={StaticResource MoneyConverter}, Mode=OneWay}"
                                     Style="{StaticResource TotalDisplay}" Width="170" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Cash received" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding ReceiveCash, UpdateSourceTrigger=PropertyChanged,
                                             Converter={StaticResource NullableDecimalConverter}}"
                                     FontSize="15" FontWeight="SemiBold" Padding="6" Width="170"
                                     HorizontalAlignment="Right" TextAlignment="Right"
                                     BorderBrush="{DynamicResource SuccessBrush}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Change / balance" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding Balance, Converter={StaticResource MoneyConverter}, Mode=OneWay}"
                                     Style="{StaticResource ReadOnlyFigure}" Width="170" HorizontalAlignment="Right"
                                     Foreground="{DynamicResource InfoTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
