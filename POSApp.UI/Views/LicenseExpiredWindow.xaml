<Window x:Class="POSApp.UI.Views.LicenseExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POSApp.UI.Views"
        mc:Ignorable="d"
        Title="License Expired"
        Height="640" Width="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/POSApp.UI;component/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="15"
            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="20" Opacity="0.25" Direction="270" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="15,15,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="txtHeadline" Text="License Expired" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{helpers:ShopTitle Screen={x:Static helpers:ProductBranding.Name}}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandGoldBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25,30,25">

                    <!-- Explanation -->
                    <TextBlock x:Name="txtMessage"
                               Text="Your one-year license has expired. Please renew to continue using the software."
                               FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,18"/>

                    <!-- Contact to renew -->
                    <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource BrandGoldBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock x:Name="txtContact" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock x:Name="txtInstructions" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Activation ID — included in the screenshot the customer sends -->
                    <TextBlock Text="Your Activation ID (include this in the screenshot):"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12,10" Margin="0,0,0,20">
                        <TextBlock x:Name="txtActivationId" FontSize="20" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{DynamicResource BrandPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Renewal code entry -->
                    <TextBlock Text="Enter Renewal Code:" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="txtCode" FontSize="18" FontFamily="Consolas" Padding="12,10"
                             CharacterCasing="Upper"
                             KeyDown="TxtCode_KeyDown"/>

                    <!-- Result message -->
                    <TextBlock x:Name="txtResult" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="btnActivate" Content="Activate" Click="BtnActivate_Click"
                                Style="{StaticResource SuccessButton}" Margin="0,0,10,0" MinWidth="130" FontSize="15"/>
                        <Button Content="Exit" Click="BtnExit_Click"
                                Style="{StaticResource DangerButton}" MinWidth="130" FontSize="15"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
