<Window x:Class="POSApp.UI.Views.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swifttill Pro" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <!-- A plan card: radio button drawn as a selectable tile -->
        <Style x:Key="PlanCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource BrandSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Height="6" Background="{DynamicResource BrandPrimaryBrush}"/>

        <StackPanel Margin="28,22,28,20">
            <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Left"
                    Background="{DynamicResource BrandSubtleBrush}">
                <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText" Text="Upgrade to Swifttill Pro" Margin="0,14,0,0"
                       FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource HintText}" FontSize="13" Margin="0,4,0,16"
                       Text="A subscription unlocks everything below. Cancel any time from your Microsoft account — your data always stays on this PC."/>

            <Border Style="{StaticResource StatTile}">
                <ItemsControl x:Name="FeatureList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Plans (filled from the Store) -->
            <TextBlock Text="Choose a plan" Style="{StaticResource FormLabel}" Margin="0,16,0,6"/>
            <TextBlock x:Name="LoadingText" Text="Loading plans from the Microsoft Store…"
                       Style="{StaticResource HintText}" FontSize="12"/>
            <ItemsControl x:Name="PlanList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="Plans" Style="{StaticResource PlanCard}"
                                     Tag="{Binding Id}" Checked="Plan_Checked" Loaded="Plan_Loaded">
                            <Grid>
                                <StackPanel Margin="0,0,110,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TrialText}" FontSize="12"
                                               Foreground="{DynamicResource SuccessTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrialText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding PriceText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                            </Grid>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="MessagePanel" Style="{StaticResource WarningCallout}" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <Grid Margin="0,16,0,0">
                <Button x:Name="LaterButton" Content="Not now" Click="Later_Click" IsCancel="True"
                        Style="{StaticResource NeutralButton}" HorizontalAlignment="Left"/>
                <Button x:Name="UpgradeButton" Content="Subscribe" Click="Upgrade_Click" IsDefault="True"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="150"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
