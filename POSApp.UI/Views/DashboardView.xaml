<UserControl x:Class="POSApp.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading + actions -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Overview" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Best sellers and items that need restocking" Style="{StaticResource HintText}"
                           FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="🔄  Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="☁  Backup to Cloud" Command="{Binding BackupToCloudCommand}"
                        Visibility="{Binding CloudBackupVisibility}"
                        Style="{StaticResource PurpleButton}" Margin="0,0,8,0"/>
                <Button Content="Restore from Cloud" Command="{Binding RestoreFromCloudCommand}"
                        Visibility="{Binding CloudBackupVisibility}"
                        Style="{StaticResource DangerTonalButton}"
                        ToolTip="Replaces all local data with the latest cloud backup"/>
            </WrapPanel>
        </Grid>

        <!-- Main Content: Top Sellers + Low Stock -->
        <Grid Grid.Row="1" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Selling Products -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🏆  Top sellers" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="Last 30 days" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="TopGrid" Grid.Row="1" ItemsSource="{Binding TopSellingProducts}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qty sold" Binding="{Binding TotalQuantity}" Width="90"
                                                ElementStyle="{StaticResource RightAlignStyle}"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding TotalRevenue, StringFormat=N0}" Width="110"
                                                ElementStyle="{StaticResource RightAlignStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="No sales in the last 30 days yet"
                               Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding HasItems, ElementName=TopGrid, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Low Stock Products -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row with title + demand order button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="⚠  Low stock" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="Out-of-stock items are shown in bold" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="📋  Demand Order"
                                Command="{Binding OpenDemandOrderCommand}"
                                Style="{StaticResource WarningButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Open demand order form to restock low-stock items"/>
                    </Grid>

                    <DataGrid x:Name="LowGrid" Grid.Row="1" ItemsSource="{Binding LowStockProducts}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"
                                                ElementStyle="{StaticResource CenterAlignStyle}"/>
                            <DataGridTextColumn Header="Alert at" Binding="{Binding Threshold}" Width="75"
                                                ElementStyle="{StaticResource CenterAlignStyle}"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="All products are well stocked 👍"
                               Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding HasItems, ElementName=LowGrid, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
