<Window x:Class="POSApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:POSApp.UI.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:POSApp.UI.Views"
        mc:Ignorable="d"
        Title="{helpers:ShopTitle Screen={x:Static helpers:ProductBranding.Name}}" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="pack://application:,,,/POSApp.UI;component/app.ico">

    <Window.Resources>

        <!-- ── Sub-item style (inside every dropdown) ─────────────────────── -->
        <Style x:Key="DropItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Padding"          Value="12,9"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="BD"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Margin="4,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BD" Property="Background" Value="{DynamicResource BrandSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Separator inside dropdowns ─────────────────────────────────── -->
        <Style x:Key="DropSepStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="12,4" Background="{DynamicResource BorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Top-level dropdown trigger (with popup) ────────────────────── -->
        <Style x:Key="NavDropStyle" TargetType="MenuItem">
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="BD"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <Path Data="M0,0 L4,4 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                          Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   PopupAnimation="Fade">
                                <!-- Margin leaves room for the shadow inside the transparent popup -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusLarge}"
                                        MinWidth="210"
                                        Margin="6,0,6,10"
                                        Padding="0,4">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="3" BlurRadius="14"
                                                          Opacity="0.14" Color="Black" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="BD" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="BD" Property="Background" Value="{DynamicResource BrandSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding OpenSaleCommand}"/>
    </Window.InputBindings>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StoreTitle}" Style="{StaticResource HeaderTitle}"
                           FontSize="22" TextTrimming="CharacterEllipsis"/>

                <!-- Right: user info + logout -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Store edition: tier badge + upgrade entry point -->
                    <Border Background="{DynamicResource BrandGoldBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0"
                            VerticalAlignment="Center" Visibility="{Binding EditionBadgeVisibility}"
                            ToolTip="{Binding EditionBadgeTooltip}">
                        <TextBlock Text="{Binding EditionBadge}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Button Content="⭐  Upgrade to Pro" Command="{Binding UpgradeCommand}"
                            Visibility="{Binding UpgradeVisibility}"
                            Style="{StaticResource WarningButton}" MinHeight="32" Padding="14,4" FontSize="12"
                            Margin="0,0,12,0" ToolTip="Subscribe to unlock wholesale, purchases, expenses, more users and more"/>
                    <Border Background="#26FFFFFF" CornerRadius="14" Padding="12,5" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserInfo}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    <Button Content="Log out"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinHeight="32" Padding="14,4" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Navigation Toolbar ────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="14,6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">

            <Menu Background="Transparent" BorderThickness="0" VerticalAlignment="Center">

                <!-- ── SALES — Admin / default role only (no SaleAccess for PharmacyUser) -->
                <MenuItem Header="📊 Sales"
                          Style="{StaticResource NavDropStyle}"
                          Visibility="{Binding SaleButtonVisibility}">
                    <MenuItem Header="🛒 Sale"          Command="{Binding OpenSaleCommand}"        Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="📦 Whole Sale"    Command="{Binding OpenWholeSaleCommand}"   Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="↩ Sale Return"   Command="{Binding OpenSaleReturnCommand}"  Style="{StaticResource DropItemStyle}"/>
                </MenuItem>

                <!-- ── PHARMACY — PharmacyUser only -->
                <MenuItem Header="💊 Pharmacy"
                          Style="{StaticResource NavDropStyle}"
                          Visibility="{Binding PharmacySaleButtonVisibility}">
                    <MenuItem Header="💊 Pharmacy Sale" Command="{Binding OpenPharmacySaleCommand}"        Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="🏥 Pharmacies"    Command="{Binding OpenPharmacyManagementCommand}" Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="⚕ Doctors"        Command="{Binding OpenDoctorManagementCommand}"   Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="🗓 Call Schedule"  Command="{Binding OpenCallScheduleCommand}"       Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding CallScheduleButtonVisibility}"/>
                </MenuItem>

                <!-- ── HR — PharmacyUser only -->
                <MenuItem Header="👥 HR"
                          Style="{StaticResource NavDropStyle}"
                          Visibility="{Binding EmployeeButtonVisibility}">
                    <MenuItem Header="👤 Employees"    Command="{Binding OpenEmployeeManagementCommand}" Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="💰 Salary Slips" Command="{Binding OpenSalarySlipCommand}"        Style="{StaticResource DropItemStyle}"/>
                </MenuItem>

                <!-- ── INVENTORY — both roles -->
                <MenuItem Header="📦 Inventory" Style="{StaticResource NavDropStyle}">
                    <MenuItem Header="🏷 Products"      Command="{Binding OpenProductManagementCommand}"  Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="⏳ Expiring Products" Command="{Binding OpenExpiringProductsCommand}" Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding ExpiringProductsVisibility}"/>
                    <MenuItem Header="📂 Categories"    Command="{Binding OpenCategoryManagementCommand}" Style="{StaticResource DropItemStyle}"/>
                    <Separator Style="{StaticResource DropSepStyle}"/>
                    <MenuItem Header="🛒 Purchase"      Command="{Binding OpenPurchaseEntryCommand}"      Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="↩ Purch. Return" Command="{Binding OpenPurchaseReturnCommand}"     Style="{StaticResource DropItemStyle}"/>
                </MenuItem>

                <!-- ── FINANCE — both roles -->
                <MenuItem Header="💰 Finance" Style="{StaticResource NavDropStyle}">
                    <MenuItem Header="🏪 Cash Register" Command="{Binding OpenShiftCommand}"         Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="💸 Expenses"       Command="{Binding OpenExpenseCommand}"       Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="{x:Static helpers:Region.CustomerAccountsMenuHeader}" Command="{Binding OpenCustomerLedgerCommand}" Style="{StaticResource DropItemStyle}"/>
                </MenuItem>

                <!-- ── REPORTS — both roles -->
                <MenuItem Header="📈 Reports" Style="{StaticResource NavDropStyle}">
                    <MenuItem Header="📊 Dashboard"    Command="{Binding OpenDashboardCommand}"    Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="📈 Sales Report" Command="{Binding OpenSalesReportCommand}"  Style="{StaticResource DropItemStyle}"/>
                    <MenuItem Header="🧾 Sales Tax Report" Command="{Binding OpenTaxReportCommand}" Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding TaxReportVisibility}"/>
                    <MenuItem Header="💊 PSE Logbook" Command="{Binding OpenPseLogCommand}" Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding PseLogVisibility}"/>
                </MenuItem>

                <!-- ── ADMIN — both roles; Users/Roles hidden for PharmacyUser -->
                <MenuItem Header="⚙ Admin" Style="{StaticResource NavDropStyle}">
                    <MenuItem Header="👥 Users"
                              Command="{Binding OpenUserManagementCommand}"
                              Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding UserManagementVisibility}"/>
                    <MenuItem Header="🔐 Roles"
                              Command="{Binding OpenRoleManagementCommand}"
                              Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding UserManagementVisibility}"/>
                    <Separator Style="{StaticResource DropSepStyle}"
                               Visibility="{Binding UserManagementVisibility}"/>
                    <MenuItem Header="⚙ Business Settings"
                              Command="{Binding OpenBusinessSettingsCommand}"
                              Style="{StaticResource DropItemStyle}"
                              Visibility="{Binding BusinessSettingsVisibility}"/>
                    <MenuItem Header="🗄 Backup" Command="{Binding OpenBackupRestoreCommand}" Style="{StaticResource DropItemStyle}"/>
                    <Separator Style="{StaticResource DropSepStyle}"/>
                    <MenuItem Header="✕ Exit"   Command="{Binding ExitCommand}"             Style="{StaticResource DropItemStyle}"/>
                </MenuItem>

            </Menu>
        </Border>

        <!-- ── Main Content — embedded Dashboard ── -->
        <views:DashboardView Grid.Row="2" DataContext="{Binding DashboardViewModel}"/>

    </Grid>
</Window>
