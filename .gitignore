# bin and obj folders
[Bb]in/
[Oo]bj/

# Visual Studio / Visual Studio Code
.vs/
.vscode/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Oo]ut/
TestResults/

# SQLite databases
*.sqlite
*.sqlite3
*.db
*.db3

# Exception: keep standard DB structure if needed, but usually we ignore local databases to avoid committing test data
# Keep posapp.db out of source control
posapp.db
# SQLite side files (write-ahead log / shared memory) and pre-restore safety copies
*.db-wal
*.db-shm
*.prerestore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Publish and Installers
clients/
publish/
dist/
installer/
POSApp_Installer/
*.zip

# NuGet
*.nupkg

# Firebase credentials (contains private key — NEVER commit)
firebase-credential.json
firebase-credentials.json
clients/*/firebase-credential.json
clients/*/firebase-credentials.json

# App settings with secrets
appsettings.json
clients/*/appsettings.json

# Vendor-only licence signing secret — must never be committed
LicenseSystem/.secret
*.secret

# Firebase / Google service account keys
**/firebase-credential*.json
**/*service-account*.json
