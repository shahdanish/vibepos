{"nodes": [{"id": "store_assets_report", "label": "SwiftTill Microsoft Store Listing Assets Report", "file_type": "document", "source_file": "store-assets/REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_assets_report_asset_checklist", "label": "Partner Center Asset Checklist", "file_type": "concept", "source_file": "store-assets/REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps each Partner Center field (poster 2:3, box art 1:1, tile icons, super hero 16:9, screenshots, trailer) to a file and PASS status; the brief calls 1440x2160 \"9:16\" but it is 2:3, which matches Partner Center spec."}, {"id": "store_assets_report_swifttill_mark", "label": "SwiftTill Mark (flat cash-register logo)", "file_type": "concept", "source_file": "store-assets/REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vector redraw of the existing app-icon.png (src/logo.svg) plus a simplified <=71px variant (src/logo-simple.svg); no new logo was invented."}, {"id": "store_assets_report_brand_palette", "label": "SwiftTill Brand Palette (navy background, green accent)", "file_type": "concept", "source_file": "store-assets/REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Palette and fonts kept in src/brand.json; artwork uses navy gradient #23314D to #141D2E with green #4DBB72 accent and Segoe UI Variable."}, {"id": "store_assets_report_render_pipeline", "label": "render.py HTML/SVG to PNG Rendering Pipeline", "file_type": "concept", "source_file": "store-assets/REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages rendered by Edge headless at device scale 1; tiles under 600 px rendered at 1200 px and