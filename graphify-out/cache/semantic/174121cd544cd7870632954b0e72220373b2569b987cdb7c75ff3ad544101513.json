{"nodes": [{"id": "us_expansion_00_discovery", "label": "US Expansion Phase 0 Discovery Report", "file_type": "document", "source_file": "docs/us-expansion/00-discovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "us_expansion_00_discovery_solution_layout", "label": "Clean Architecture Solution Layout (Core/Data/Infrastructure/UI/Tests)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five projects: Core (entities, interfaces, pure services), Data (EF Core 9 + SQLite, 19 migrations), Infrastructure (repositories, cloud backup, edition, license, barcode), UI (WPF MVVM), Tests (xUnit + Moq)."}, {"id": "us_expansion_00_discovery_logic_in_viewmodels", "label": "Business Logic Inside ViewModels", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1,s12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Totals, saving and printing live inside ViewModels (SaleViewModel 1,097 lines, PharmacySaleViewModel 1,270) with no checkout/service layer, so tax, tenders, FEFO, PSE and Rx cannot be tested or made atomic there."}, {"id": "us_expansion_00_discovery_sale_calculator", "label": "Proposed SaleCalculator (pure, in Core)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12,s13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure unit-tested calculator with AwayFromZero rounding at line-tax level; the PK path keeps its exact current math, locked by characterization tests written first."}, {"id": "us_expansion_00_discovery_checkout_service", "label": "Proposed Transactional CheckoutService", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Infrastructure service making sale save, stock/batch deduction, PSE log and Rx status one transaction; US checkout path selected by Region."}, {"id": "us_expansion_00_discovery_characterization_tests", "label": "PK Characterization (Golden) Tests", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mitigates PK regression risk: golden tests on PK receipt text and totals before refactoring; US behaviour only when RegionCode == US."}, {"id": "us_expansion_00_discovery_preexisting_failing_tests", "label": "Two Pre-existing Failing Tests", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ClearForm_ResetsAllProperties has a stale assertion (CostPrice now null); Preview_DoesNotLeakUnsavedSettingsIntoTheApp fails because the static Region cache is shared across parallel test classes and tests read the real region-settings.json."}, {"id": "us_expansion_00_discovery_runtime_editions", "label": "Three Runtime Editions (Direct, StoreLite, StorePro)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1,s9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One codebase: Direct (Inno Setup, yearly licence, all features) and MSIX Swifttill StoreLite/StorePro (subscription add-on)."}, {"id": "us_expansion_00_discovery_edition_policy_gating", "label": "EditionPolicy.IsInBuild Feature Gating", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pharmacy, CloudBackup and YearlyLicence are Direct-only: pharmacy is a vertical with regulatory questions, and cloud backup needs a service-account key that must not ship inside a public package. Changing it touches Store monetization and needs the owner decision (Hard Rule 7)."}, {"id": "us_expansion_00_discovery_frontstore_pharmacy_feature", "label": "Proposed AppFeature.FrontStorePharmacy", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13,s14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "US front-store pharmacy features gated on a new AppFeature (recommended Store Pro only), separate from the existing distributor Pharmacy feature which stays Direct-only."}, {"id": "us_expansion_00_discovery_pharmacy_name_collision", "label": "Distributor Pharmacy vs US Front-Store Pharmacy Collision", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing Pharmacy feature is a PK pharma-distribution workflow (B2B to pharmacies, doctors, medical reps, bonus units). PharmacyUser is a distributor-ops role, not a pharmacist; US features need distinct names (FrontStorePharmacy, Rx, WillCall)."}, {"id": "us_expansion_00_discovery_rbac", "label": "Database-Driven RBAC (23 permissions, seeded roles)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permission constants seeded via HasData; runtime checks via SessionManager.HasPermission (HashSet). Seeded roles Admin, Manager, Cashier, PharmacyUser. Proposal: add Owner, Pharmacist, PharmacyTech additively."}, {"id": "us_expansion_00_discovery_region_facade", "label": "Region Static Formatting Facade", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Region in UI holds currency, number words, separators, date style; defaults reproduce Pakistan exactly. It lives in UI so Core/Infrastructure cannot use it, and its static mutable state causes flaky tests. Needs RegionCode (PK/US) and Culture."}, {"id": "us_expansion_00_discovery_format_service", "label": "Proposed IFormatService in Core", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12,s13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure, culture-parameterised service; Region becomes a facade over it so ~50 call sites and XAML x:Static keep working while PK output stays byte-identical."}, {"id": "us_expansion_00_discovery_hardcoded_formatting", "label": "Hard-Coded Money and Date Formats Bypassing Region", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C# N0/N2 and XAML StringFormat ignore shop separator settings, and N0 drops cents ($3.49 prints as 3); fixed dd-MMM / day-first dates are ambiguous to US users."}, {"id": "us_expansion_00_discovery_settings_storage_split", "label": "Settings Storage Split (JSON files vs DB)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "region-settings.json, receipt-branding.json and per-user settings.json are outside cloud backups and lost on restore to a new PC; new business rules (tax config, PharmacyMode, PSE limits) should live in the DB so they travel with backups."}, {"id": "us_expansion_00_discovery_cloud_backup_restore", "label": "Firestore Whole-DB Cloud Backup and Restore", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native SQLite backup of the whole posapp.db, gzip, Base64, ~700 KB chunks in Firestore with sha256/chunkCount/schemaVersion metadata; keeps last 5 snapshots; restore verifies hash, refuses backups from a newer app, saves a .prerestore copy. Direct edition only."}, {"id": "us_expansion_00_discovery_additive_migrations_rule", "label": "Additive Migrations Rule", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old cloud backups restore cleanly because Database.Migrate() upgrades the restored DB on next start, provided every new migration is additive and defaults existing rows. This is what keeps Hard Rule 3 (backup keeps working) true."}, {"id": "us_expansion_00_discovery_premigration_backup", "label": "Pre-Migration DB Backup (Hard Rule 2)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s2,s13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No backup is taken before Migrate() today; proposal is a posapp.premigrate-<migration>.db copy when pending migrations exist."}, {"id": "us_expansion_00_discovery_ef_migrations_sqlite", "label": "EF Core Migrations on SQLite (WAL)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied by Database.Migrate() at startup; no model drift; DB at AppPaths.DatabasePath, relocatable with POSAPP_DATA_DIR."}, {"id": "us_expansion_00_discovery_decimals_stored_as_text", "label": "Decimals Stored as TEXT in SQLite", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQLite has no decimal type so HasPrecision is cosmetic; SQL ORDER BY on money is text-based, so avoid SQL-side ordering of money."}, {"id": "us_expansion_00_discovery_receipt_printing", "label": "Per-ViewModel Receipt Printing (no shared print service)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each ViewModel builds its own FlowDocument/FixedDocument and calls PrintDialog.PrintDocument to the default printer without a dialog; UseSmallBillFormat switches 280 px (~80 mm) vs full page; 58 mm unsupported; no barcode/QR printed though ZXing is available."}, {"id": "us_expansion_00_discovery_directprintservice_missing", "label": "DirectPrintService Documented but Absent", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1,s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAUDE.md mentions a DirectPrintService in Infrastructure but it does not exist."}, {"id": "us_expansion_00_discovery_no_tax_unrounded_discounts", "label": "No Sales Tax and Unrounded Discount Math", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only payroll IncomeTax exists. Line % or flat discounts plus two flat bill discounts; no rounding at all, so split discounts can store more than two decimals."}, {"id": "us_expansion_00_discovery_khata_vs_store_credit", "label": "Khata (customer owes) vs US Store Credit (shop owes) Ledgers", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two opposite semantics of credit; must be separate ledgers, never reuse Customer.CurrentBalance for both."}, {"id": "us_expansion_00_discovery_sensitive_data_risk", "label": "Sensitive Patient/PSE Data in Plain SQLite", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No encryption at rest; realistic scope is access control and audit, worded as \"designed to limit access\"."}, {"id": "us_expansion_00_discovery_b1_stale_sale_timestamp", "label": "B1 Stale Sale Timestamp", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SaleDate is set once at ViewModel construction and never reset by NewSale(), so every sale in a session gets the window-open time. Z reports, shift cash, tax-by-period and PSE windows depend on it; fix before Phase 1 reports."}, {"id": "us_expansion_00_discovery_b2_duplicate_invoice_numbers", "label": "B2 Duplicate Invoice Numbers", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GetNextInvoiceNumberAsync parses the last row; a return (\"R-...\") makes it fall back to 11016; no unique index. Return-by-receipt-barcode could hit the wrong sale."}, {"id": "us_expansion_00_discovery_b3_shift_expected_cash", "label": "B3 Wrong Shift Expected Cash", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected cash sums ReceiveCash (tendered, pre-change) across every payment type and ignores refunds; meaningless once card tenders exist; fixing changes the PK over/short number."}, {"id": "us_expansion_00_discovery_b4_nonatomic_sale_save", "label": "B4 Non-Atomic Sale Save", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sale insert, per-product updates and customer update use separate SaveChanges, so a crash can leave stock or khata inconsistent; FEFO/PSE/Rx must be in one transaction."}, {"id": "us_expansion_00_discovery_b5_saleitem_shadow_fk", "label": "B5 SaleItem.Product Shadow FK Always Null", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SaleItem.ProductId is a string but the Product key is int, so EF created shadow FK ProductId1 that is never set; category/product reports resolve as Uncategorized. Reports must join on the product code string."}, {"id": "us_expansion_00_discovery_b6_stock_quantity_rounding", "label": "B6 Stock Check and Quantity Rounding", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock is int but decimal quantities are deducted with Math.Ceiling; out-of-stock is checked only on the barcode path."}, {"id": "us_expansion_00_discovery_b7_barcode_exact_match", "label": "B7 Barcode Exact Match and Invalid Generated UPC-A", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookup is an exact string match, Barcode is not unique, and generated yyMMddHHmmss codes look like UPC-A with an invalid check digit."}, {"id": "us_expansion_00_discovery_b8_missing_indexes", "label": "B8 Missing Indexes and In-Memory Reports", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No indexes on Sales.SaleDate, Sales.InvoiceNumber, Products.ProductId, SaleItems.ProductId; reports load full graphs into memory; target is 200k lines."}, {"id": "us_expansion_00_discovery_phase_1a_safety_foundation", "label": "Phase 1a: Safety and Foundation", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "us_expansion_00_discovery_phase_1b_us_checkout_core", "label": "Phase 1b: US Checkout Core (tax, tenders)", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "us_expansion_00_discovery_phase_1c_drawer_receipts_identifiers", "label": "Phase 1c: Drawer, Receipts, Identifiers", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "us_expansion_00_discovery_phase_2_pharmacy_front_store", "label": "Phase 2: Pharmacy Front Store", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "us_expansion_00_discovery_phase_3_demo_data", "label": "Phase 3: Demo Data Seeder", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DemoDataSeeder in Infrastructure writing to a separate data dir via POSAPP_DATA_DIR with a fixed seed; bypasses SyncLogInterceptor and uses bulk inserts; screenshots from an unpackaged Debug build."}, {"id": "us_expansion_00_discovery_phase_4_hardening_packaging", "label": "Phase 4: Hardening and Packaging", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "us_expansion_00_discovery_q1_edition_placement", "label": "Open Question Q1: Edition Placement of US Pharmacy Features", "file_type": "concept", "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Options: Store Pro only (recommended), Store Lite and Pro, or Direct only. Cloud backup stays Direct-only, so Store users rely on local backups."}], "edges": [{"source": "us_expansion_00_discovery", "target": "us_expansion_00_discovery_solution_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1", "weight": 1.0}, {"source": "us_expansion_00_discovery_logic_in_viewmodels", "target": "viewmodels_saleviewmodel_saleviewmodel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1", "weight": 1.0}, {"source": "us_expansion_00_discovery_solution_layout", "target": "us_expansion_00_discovery_logic_in_viewmodels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s1", "weight": 1.0}, {"source": "us_expansion_00_discovery_sale_calculator", "target": "us_expansion_00_discovery_logic_in_viewmodels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/us-expansion/00-discovery.md", "source_location": "s12", "weight": 1.0}, {"source": "us_expansion_00_discovery_checkout_service", "target": "us_expansion_00_discovery_sale_calculator", "relation": "references", "confidence": "E