{"nodes": [{"id": "packaging_readme", "label": "Swifttill Store Edition Packaging README", "file_type": "document", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packaging_readme_swifttill_edition", "label": "Swifttill Microsoft Store Edition", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One codebase ships as Direct (Inno Setup, Shah Jee POS) or Microsoft Store MSIX (Swifttill); detected by running from an MSIX package."}, {"id": "packaging_readme_direct_vs_store", "label": "Direct vs Store Distribution Matrix", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct: yearly renewal codes, all features incl. pharmacy and cloud backup, seeded logins. Store: Microsoft Store licensing, Lite (free) + Pro subscription, no pharmacy/cloud backup, first-run wizard creates the owner."}, {"id": "packaging_readme_pro_subscription", "label": "Swifttill Pro Subscription Add-ons", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subscription add-ons pro_monthly / pro_yearly; any Product ID starting with pro_ unlocks Pro (EditionService.ProProductIdPrefix). Pro unlocks wholesale, purchases and suppliers, expenses, Excel export, >2 users, custom roles, HR. A lapsed subscription drops back to Lite without touching data."}, {"id": "packaging_readme_lite_edition", "label": "Swifttill Lite (free tier)", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packaging_readme_posapp_data_dir", "label": "POSAPP_DATA_DIR Data Directory Override", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Env var relocates database/logs/settings so tests, demos and Store-behaviour tries never touch real data."}, {"id": "packaging_readme_posapp_edition", "label": "POSAPP_EDITION Edition Override (Debug builds only)", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Values lite/pro/direct simulate Store editions without packaging; in Debug + lite the upgrade dialog shows sample plans and Subscribe simulates a purchase."}, {"id": "packaging_readme_partner_center_submission", "label": "Partner Center Submission Process", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserve name, copy identity into store-identity.json, create subscription add-ons, build MSIX, run certification kit, upload the unsigned msix (the Store signs it) with screenshots, description, age rating and privacy policy URL."}, {"id": "packaging_readme_store_identity_json", "label": "packaging/store-identity.json", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds Package/Identity/Name, Publisher CN and PublisherDisplayName copied from Partner Center product identity."}, {"id": "packaging_readme_build_msix_script", "label": "build-msix.ps1 / Build-MSIX.cmd", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds dist/Swifttill-<version>.msix; every submission needs a higher version; -Sign and -Install support local test installs; refuses to package firebase-credentials.json."}, {"id": "packaging_readme_app_certification_kit", "label": "Windows App Certification Kit (appcert) Run", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packaging_readme_privacy_policy_requirement", "label": "Privacy Policy URL Requirement", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required because the app stores customer names and phone numbers; the Store edition sends nothing anywhere (no cloud backup) and the policy should say so."}, {"id": "packaging_readme_run_full_trust_justification", "label": "runFullTrust Restricted Capability Justification", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A full-trust desktop app must explain it needs direct thermal-printer access and a local SQLite database."}, {"id": "packaging_readme_local_test_install", "label": "Signed Local Test Install", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test-signing cert imported into TrustedPeople; uninstalling a packaged app deletes its data, so customers must use Admin > Backup first."}, {"id": "packaging_readme_data_location", "label": "Data Location via AppPaths (MSIX redirect)", "file_type": "concept", "source_file": "packaging/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database and logs in %LocalAppData%\\ShahJeePOS, redirected into package private storage under MSIX; a legacy posapp.db beside the exe is copied (not moved) on first start."}], "edges": [{"source": "packaging_readme", "target": "packaging_readme_swifttill_edition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme", "target": "packaging_readme_direct_vs_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme_swifttill_edition", "target": "packaging_readme_direct_vs_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme_swifttill_edition", "target": "packaging_readme_pro_subscription", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme_swifttill_edition", "target": "packaging_readme_lite_edition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme_pro_subscription", "target": "services_editionservice_editionservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme_pro_subscription", "target": "services_edition_editionpolicy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packaging/README.md", "source_location": null, "weight": 1.0}, {"source": "packaging_readme_direct_vs_store", "target": "licensesystem_readme_yearly_license", "relation": "references", "confidence": "EXTRACTED", "confidence