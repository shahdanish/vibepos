{"nodes": [{"id": "store_assets_listing", "label": "SwiftTill Microsoft Store Listing Text", "file_type": "document", "source_file": "store-assets/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "store_assets_listing_feature_bullets", "label": "Store Product Features (12 bullets)", "file_type": "concept", "source_file": "store-assets/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each bullet <=60 chars and backed by named code: barcode billing, shortcuts, 80mm/A4 printing, receipt branding, products/categories, low-stock alerts, khata ledger, sales reports, returns and shifts, local backup, offline, Pro extras."}, {"id": "store_assets_listing_search_keywords", "label": "Store Search Keywords (7)", "file_type": "concept", "source_file": "store-assets/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven keywords totalling 14 words against a 21-word cap."}, {"id": "store_assets_listing_claims_vs_code_audit", "label": "Listing Claims vs Code Audit", "file_type": "concept", "source_file": "store-assets/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every product-summary claim is checked against code and whether it exists in the Store build via EditionPolicy.IsInBuild; no unsupported claim appears in bullets or keywords."}, {"id": "store_assets_listing_claim_for_pharmacies", "label": "Claim: For Pharmacies (not in Store build)", "file_type": "concept", "source_file": "store-assets/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PharmacySaleWindow, PharmacyManagementWindow and DoctorManagementWindow exist but EditionPolicy.IsInBuild(Pharmacy) is Direct-only, so remove from 