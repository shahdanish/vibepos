{"nodes": [{"id": "licensesystem_readme", "label": "License System README (Yearly Expiry and Renewal)", "file_type": "document", "source_file": "LicenseSystem/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "licensesystem_readme_yearly_license", "label": "Yearly Time-Limited License", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App runs one year from first install, then blocks itself and shows the vendor contact number until a renewal code is bought. Fully offline: no internet needed. A \"license expiring soon\" popup appears in the last 15 days."}, {"id": "licensesystem_readme_activation_id", "label": "Activation ID", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Format A1B2C3D4-01: first part derived from the PC hardware ID, suffix is the renewal number. Shown on a screenshot-friendly screen so nothing has to be read aloud and characters cannot be misheard."}, {"id": "licensesystem_readme_renewal_code", "label": "Renewal Code", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed code bound to both the specific PC and the renewal number, so it only works once on one machine (replay protection). Case-insensitive, dashes optional."}, {"id": "licensesystem_readme_renewal_workflow", "label": "WhatsApp Renewal Workflow", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer pays, WhatsApps a screenshot of the expiry screen, vendor generates a code and replies; customer types it in and the license extends one year."}, {"id": "licensesystem_readme_test_mode", "label": "TestMode One-Minute Expiry Flag", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s3-s4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Const in LicenseService compresses the license to one minute for testing. A build shipped with TestMode=true expires one minute after first launch; this already happened once, so it is the most important item on the shipping checklist."}, {"id": "licensesystem_readme_repair_short_period", "label": "RepairShortPeriod Self-Repair", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On every load raises any expiry below install date + (renewals+1) x 1 year. Lets customers poisoned by a TestMode build back in without a renewal code, while never shortening a legitimate license nor gifting time to a genuinely expired one."}, {"id": "licensesystem_readme_dual_store_record", "label": "DPAPI Dual-Store License Record", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Install date, expiry, last-run time and renewal count are JSON-serialized, DPAPI-encrypted (LocalMachine) and written to both HKCU registry and a hidden ProgramData file; on launch both are reconciled (earliest install wins, latest expiry/renewal wins) so deleting one copy cannot reset the trial."}, {"id": "licensesystem_readme_clock_rollback_detection", "label": "Clock Rollback Detection", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s1,s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A monotonic last-run timestamp detects the Windows clock being set backwards and blocks with a date/time problem message."}, {"id": "licensesystem_readme_renewal_secret", "label": "RenewalSecret Signing Secret", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s4,s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must match exactly between LicenseService.RenewalSecret and $Secret in the generator script and must never change after shipping. Because verification is offline the secret ships inside the exe: this stops ordinary shop users but not a determined reverse-engineer; online activation is the stronger next step."}, {"id": "licensesystem_readme_shipping_checklist", "label": "Pre-Shipping License Checklist", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TestMode to false, real WhatsApp number, private RenewalSecret set once and mirrored in the script, clear stored license so the build starts fresh."}, {"id": "licensesystem_readme_license_expired_window", "label": "LicenseExpiredWindow (blocking expiry screen)", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s1,s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shown before the login screen once expired; displays contact number, Activation ID and a renewal code box."}, {"id": "licensesystem_readme_startup_license_gate", "label": "Startup License Gate in App.xaml.cs", "file_type": "concept", "source_file": "LicenseSystem/README.md", "source_location": "s6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs CheckLicense() before the login window and blocks the app if expired."}], "edges": [{"source": "licensesystem_readme", "target": "services_licenseservice_licenseservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s6", "weight": 1.0}, {"source": "licensesystem_readme", "target": "interfaces_ilicenseservice_ilicenseservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s6", "weight": 1.0}, {"source": "licensesystem_readme", "target": "licensesystem_generate_renewal_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s2", "weight": 1.0}, {"source": "services_licenseservice_licenseservice", "target": "licensesystem_readme_yearly_license", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s6", "weight": 1.0}, {"source": "licensesystem_readme_yearly_license", "target": "licensesystem_readme_dual_store_record", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s6", "weight": 1.0}, {"source": "licensesystem_readme_yearly_license", "target": "licensesystem_readme_clock_rollback_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s1", "weight": 1.0}, {"source": "licensesystem_readme_clock_rollback_detection", "target": "licensesystem_readme_dual_store_record", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s6", "weight": 1.0}, {"source": "licensesystem_readme_renewal_code", "target": "licensesystem_readme_activation_id", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LicenseSystem/README.md", "source_location": "s2", "weight": 1.0}, {"source": "licensesystem_readme_renewal_workflow", "ta